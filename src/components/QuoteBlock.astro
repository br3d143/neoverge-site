---
/**
 * QuoteBlock — large pull-quote with optional eyebrow label and attribution.
 * Used for mission/vision statements and testimonials.
 */
import Eyebrow from "./Eyebrow.astro";

interface Props {
  label?: string;
  attribution?: string;
  /** initials drawn as an SVG avatar (no broken image links) */
  initials?: string;
  size?: "display-m" | "display-l";
  class?: string;
}
const { label, attribution, initials, size = "display-m", class: className = "" } =
  Astro.props;
const quoteSize = size === "display-l" ? "text-display-m md:text-display-l" : "text-heading-l md:text-display-m";
---

<figure class:list={["flex flex-col gap-6", className]}>
  {label && <Eyebrow tone="muted">{label}</Eyebrow>}
  <blockquote class:list={["font-display text-foreground text-balance", quoteSize]}>
    <slot />
  </blockquote>
  {
    (attribution || initials) && (
      <figcaption class="flex items-center gap-3">
        {initials && (
          <span
            class="grid h-10 w-10 place-items-center rounded-full bg-foreground/[0.06] font-body text-body-s font-semibold text-muted"
            aria-hidden="true"
          >
            {initials}
          </span>
        )}
        {attribution && <span class="font-body text-body-s text-muted">{attribution}</span>}
      </figcaption>
    )
  }
</figure>
