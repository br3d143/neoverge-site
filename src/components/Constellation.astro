---
/**
 * Constellation — a subtle drifting starfield of element-colored points with faint
 * connecting lines (the brand's "constellation of learning"). Canvas-based, capped
 * particle count, pauses to a single static frame under prefers-reduced-motion.
 */
---

<canvas class="constellation" aria-hidden="true"></canvas>

<style>
  .constellation {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script is:inline>
  (function () {
    const canvas = document.querySelector(".constellation");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const palette = [[25, 149, 73], [93, 169, 179], [238, 143, 39], [169, 171, 174]];
    let w = 0, h = 0, dpr = 1, particles = [], raf = 0, tick = 0;

    function build() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect();
      w = r.width; h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.max(40, Math.min(120, Math.floor((w * h) / 9000)));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.22,
        vy: (Math.random() - 0.5) * 0.22,
        r: Math.random() * 1.8 + 0.9,
        c: palette[(Math.random() * palette.length) | 0],
      }));
    }

    function frame() {
      tick++;
      ctx.clearRect(0, 0, w, h);
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        if (!reduce) {
          p.x += p.vx; p.y += p.vy;
          if (p.x < 0) p.x = w; else if (p.x > w) p.x = 0;
          if (p.y < 0) p.y = h; else if (p.y > h) p.y = 0;
        }
        for (let j = i + 1; j < particles.length; j++) {
          const q = particles[j];
          const dx = p.x - q.x, dy = p.y - q.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < 120) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(q.x, q.y);
            ctx.strokeStyle = "rgba(26,26,26," + 0.08 * (1 - d / 120) + ")";
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
        const a = 0.72;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, 6.2832);
        ctx.fillStyle = "rgba(" + p.c[0] + "," + p.c[1] + "," + p.c[2] + "," + a + ")";
        ctx.fill();
      }
      if (!reduce) raf = requestAnimationFrame(frame);
    }

    function start() {
      build();
      cancelAnimationFrame(raf);
      frame();
    }
    let t;
    window.addEventListener("resize", () => {
      clearTimeout(t);
      t = setTimeout(start, 200);
    });
    start();
  })();
</script>
