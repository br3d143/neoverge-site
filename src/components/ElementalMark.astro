---
/**
 * ElementalMark — a hand-built, animated SVG recreation of the NeoVerge elemental emblem.
 * Five living elements inside a gradient ring: leaves sway, flame flickers, wave undulates,
 * wind drifts, roots sway. All motion is CSS-driven so it pauses under prefers-reduced-motion.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class:list={["nv-mark", className]}
  viewBox="0 0 200 200"
  role="img"
  aria-label="NeoVerge elemental emblem"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="nv-ring" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#5da9b3"></stop>
      <stop offset="0.45" stop-color="#199549"></stop>
      <stop offset="1" stop-color="#ee8f27"></stop>
    </linearGradient>
    <clipPath id="nv-clip"><circle cx="100" cy="100" r="86"></circle></clipPath>
  </defs>

  <circle cx="100" cy="100" r="86" fill="#ffffff"></circle>

  <g clip-path="url(#nv-clip)">
    <!-- WAVE (two drifting bands) -->
    <g class="nv-wave-back">
      <path d="M-20,113 q15,-7 30,0 t30,0 t30,0 t30,0 t30,0 t30,0 t30,0 t30,0" fill="none" stroke="#a1cdd3" stroke-width="6" stroke-linecap="round"></path>
    </g>
    <g class="nv-wave-front">
      <path d="M-20,120 q15,-8 30,0 t30,0 t30,0 t30,0 t30,0 t30,0 t30,0 t30,0" fill="none" stroke="#5da9b3" stroke-width="7" stroke-linecap="round"></path>
    </g>

    <!-- ROOTS -->
    <g transform="translate(103,124)">
      <g class="nv-roots" fill="none" stroke="#8c5f3d" stroke-width="3" stroke-linecap="round">
        <path d="M0,-4 C0,6 -4,12 -13,21"></path>
        <path d="M0,-4 C0,8 -1,18 -3,31"></path>
        <path d="M0,-4 C0,8 2,16 12,22"></path>
        <path d="M0,-4 C0,10 5,18 9,30"></path>
      </g>
    </g>

    <!-- WIND -->
    <g transform="translate(60,90)">
      <g class="nv-wind" fill="none" stroke="#a9abae" stroke-width="2.6" stroke-linecap="round">
        <path d="M-14,-6 H4 c6,0 6,-7 0.5,-7"></path>
        <path d="M-14,1 H9 c7,0 7,8 0.5,8"></path>
        <path d="M-14,8 H2"></path>
      </g>
    </g>

    <!-- LEAVES -->
    <g transform="translate(99,82)">
      <g class="nv-leaves">
        <g fill="#199549">
          <path d="M0,0 C6,-9 7,-21 0,-31 C-7,-21 -6,-9 0,0 Z" transform="rotate(-26)"></path>
          <path d="M0,0 C6,-9 7,-21 0,-31 C-7,-21 -6,-9 0,0 Z"></path>
          <path d="M0,0 C6,-9 7,-21 0,-31 C-7,-21 -6,-9 0,0 Z" transform="rotate(26)"></path>
        </g>
        <g fill="none" stroke="#0f562a" stroke-width="1" opacity="0.45">
          <path d="M0,-2 L0,-26" transform="rotate(-26)"></path>
          <path d="M0,-2 L0,-27"></path>
          <path d="M0,-2 L0,-26" transform="rotate(26)"></path>
        </g>
      </g>
    </g>

    <!-- FLAME -->
    <g transform="translate(131,84)">
      <g class="nv-flame">
        <path fill="#ee8f27" d="M1,5 C10,-1 7,-14 2,-22 C1,-29 -4,-29 -3,-22 C-3,-15 -7,-14 -6,-20 C-12,-13 -10,-1 -3,4 C-2,6 0,6 1,5 Z"></path>
        <path class="nv-flame-inner" fill="#f5be82" d="M0,2 C5,-2 4,-11 0,-17 C-4,-11 -4,-3 0,2 Z"></path>
      </g>
    </g>
  </g>

  <circle cx="100" cy="100" r="88" fill="none" stroke="url(#nv-ring)" stroke-width="4"></circle>
</svg>

<style>
  .nv-mark {
    height: auto;
    display: block;
  }
  .nv-leaves {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: nv-sway 4.8s ease-in-out infinite;
  }
  .nv-flame {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: nv-flicker 1.1s ease-in-out infinite;
  }
  .nv-flame-inner {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: nv-flicker2 0.85s ease-in-out infinite;
  }
  .nv-wave-front {
    animation: nv-wave 7s linear infinite;
  }
  .nv-wave-back {
    animation: nv-wave 11s linear infinite;
  }
  .nv-wind {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: nv-wind 3.4s ease-in-out infinite;
  }
  .nv-roots {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    animation: nv-rootsway 6s ease-in-out infinite;
  }
  @keyframes nv-sway {
    0%, 100% { transform: rotate(-3.5deg); }
    50% { transform: rotate(3.5deg); }
  }
  @keyframes nv-flicker {
    0%, 100% { transform: scaleY(1) scaleX(1) rotate(-1deg); }
    50% { transform: scaleY(1.12) scaleX(0.95) rotate(1.5deg); }
  }
  @keyframes nv-flicker2 {
    0%, 100% { transform: scaleY(0.9); }
    50% { transform: scaleY(1.18); }
  }
  @keyframes nv-wave {
    to { transform: translateX(-60px); }
  }
  @keyframes nv-wind {
    0%, 100% { transform: translateX(-2px); }
    50% { transform: translateX(3px); }
  }
  @keyframes nv-rootsway {
    0%, 100% { transform: rotate(-1.2deg); }
    50% { transform: rotate(1.2deg); }
  }
</style>
