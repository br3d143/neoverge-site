---
/**
 * WorldHero — the Hero.World variant (brief Section 7): a world-page hero themed
 * in the world's element color, with a faint logo backdrop and an accent underline.
 */
import Container from "./Container.astro";
import Eyebrow from "./Eyebrow.astro";
import Heading from "./Heading.astro";
import Button from "./Button.astro";

interface Props {
  world: "earth" | "water" | "fire" | "air";
  meta: string;
  heading: string;
  tagline: string;
  intro: string;
  status?: "Active" | "Coming soon";
  logo: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const { world, meta, heading, tagline, intro, status, logo, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;

const accentLine = { earth: "bg-earth", water: "bg-water", fire: "bg-fire", air: "bg-air" }[world];
---

<section class="relative overflow-hidden">
  <img
    src={logo}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute right-[-8%] top-1/2 hidden w-[48%] max-w-[36rem] -translate-y-1/2 opacity-[0.06] lg:block"
  />
  <Container class="relative flex min-h-[88vh] flex-col justify-center pt-28 pb-2xl">
    <div class="max-w-[44rem]">
      <Eyebrow tone={world}>{meta}</Eyebrow>
      <Heading level={1} size="display-l" tone={world} class="mt-4">{heading}</Heading>
      <span class:list={["mt-6 block h-1 w-16 rounded-full", accentLine]} aria-hidden="true"></span>
      <p class="mt-7 font-display text-heading-l text-foreground">{tagline}</p>
      <p class="mt-5 max-w-[40rem] text-body-l text-muted">{intro}</p>
      {status === "Coming soon" && (
        <p class="mt-6"><Eyebrow tone="subtle">Coming soon</Eyebrow></p>
      )}
      {
        (primaryHref || secondaryHref) && (
          <div class="mt-9 flex flex-wrap items-center gap-4">
            {primaryHref && (
              <Button href={primaryHref} world={world} size="lg">{primaryLabel}</Button>
            )}
            {secondaryHref && (
              <Button href={secondaryHref} variant="secondary" size="lg">{secondaryLabel}</Button>
            )}
          </div>
        )
      }
    </div>
  </Container>
</section>
