---
/**
 * WorldHero — world-page hero (Hero.World). Two columns: themed copy on the left,
 * the world's logo shown prominently in an element-tinted card on the right.
 * Constellation behind. Stacks on mobile (copy first, logo below).
 */
import Container from "./Container.astro";
import Eyebrow from "./Eyebrow.astro";
import Heading from "./Heading.astro";
import Button from "./Button.astro";
import Constellation from "./Constellation.astro";
import DecorMotif from "./DecorMotif.astro";

interface Props {
  world: "earth" | "water" | "fire" | "air";
  name: string;
  meta: string;
  heading: string;
  tagline: string;
  intro: string;
  status?: "Active" | "Coming soon";
  logo: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const { world, name, meta, heading, tagline, intro, status, logo, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;

const accentLine = { earth: "bg-earth", water: "bg-water", fire: "bg-fire", air: "bg-air" }[world];
const tintBg = { earth: "bg-earth-tint", water: "bg-water-tint", fire: "bg-fire-tint", air: "bg-air-tint" }[world];
const ringBorder = { earth: "border-earth/30", water: "border-water/30", fire: "border-fire/30", air: "border-air/30" }[world];
---

<section class="relative isolate overflow-hidden">
  <Constellation />
  <DecorMotif type={world} class="pointer-events-none absolute bottom-[-6%] left-[-5%] z-0 hidden h-80 w-80 opacity-[0.05] lg:block" />
  <Container class="relative z-[1] grid min-h-[86vh] items-center gap-2xl py-28 md:grid-cols-[1.15fr_1fr] md:gap-3xl">
    <div class="max-w-[40rem]" data-reveal>
      <Eyebrow tone={world}>{meta}</Eyebrow>
      <Heading level={1} size="display-l" tone={world} class="mt-4">{heading}</Heading>
      <span class:list={["mt-6 block h-1 w-16 rounded-full", accentLine]} aria-hidden="true"></span>
      <p class="mt-7 font-display text-heading-l text-foreground">{tagline}</p>
      <p class="mt-5 max-w-[40rem] text-body-l text-muted">{intro}</p>
      {status === "Coming soon" && (
        <p class="mt-6"><Eyebrow tone="subtle">Coming soon</Eyebrow></p>
      )}
      {
        (primaryHref || secondaryHref) && (
          <div class="mt-9 flex flex-wrap items-center gap-4">
            {primaryHref && (
              <Button href={primaryHref} world={world} size="lg">{primaryLabel}</Button>
            )}
            {secondaryHref && (
              <Button href={secondaryHref} variant="secondary" size="lg">{secondaryLabel}</Button>
            )}
          </div>
        )
      }
    </div>

    <div class="flex justify-center" data-reveal>
      <div class:list={["flex aspect-square w-full max-w-[26rem] items-center justify-center rounded-[2rem] border p-12 shadow-[0_24px_70px_-30px_rgba(26,26,26,0.3)]", tintBg, ringBorder]}>
        <img src={logo} alt={`${name} logo`} class="max-h-full max-w-full object-contain" width="800" height="800" fetchpriority="high" />
      </div>
    </div>
  </Container>
</section>
