---
/**
 * WorldHero — immersive world hero. Section 1: the world logo huge + the element's
 * own themed animation (ElementHeroFX) + optional figure silhouettes (Pulse dancers).
 * Section 2 (below): the meta/heading/tagline/intro + CTAs in their own section.
 */
import Section from "./Section.astro";
import Eyebrow from "./Eyebrow.astro";
import Heading from "./Heading.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import ElementHeroFX from "./ElementHeroFX.astro";

interface Props {
  world: "earth" | "water" | "fire" | "air";
  name: string;
  meta: string;
  heading: string;
  tagline: string;
  intro: string;
  status?: "Active" | "Coming soon";
  logo: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const { world, name, meta, heading, tagline, intro, status, logo, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;

const wvar = {
  earth: "[--w:var(--color-earth)]",
  water: "[--w:var(--color-water)]",
  fire: "[--w:var(--color-fire)]",
  air: "[--w:var(--color-air)]",
}[world];
const accentLine = { earth: "bg-earth", water: "bg-water", fire: "bg-fire", air: "bg-air" }[world];
// Theme icon per world (what the school teaches, not the brand element).
const elementIcon = { earth: "leaf", water: "basketball", fire: "music", air: "globe" }[world];
const accentText = { earth: "text-earth-accent", water: "text-water-accent", fire: "text-fire-accent", air: "text-air-accent" }[world];
// Per-world logo height — the logos have very different aspect ratios, so a single
// height makes the wide wordmarks (NeoVerse) huge and the tall stacked lockup (Pulse)
// small. Tall/compact logos get a bigger height so every world reads equally large.
const markHeight = {
  earth: "clamp(150px, 28vh, 300px)", // wide wordmark — width-limited anyway
  water: "clamp(200px, 34vh, 380px)", // landscape lockup
  fire: "clamp(300px, 52vh, 560px)", // tall stacked lockup — needs the most height
  air: "clamp(240px, 40vh, 440px)", // squarish lockup
}[world];
---

<section class:list={["world-hero relative isolate flex min-h-[100dvh] items-center justify-center overflow-hidden px-6", wvar]} style={`--mark-h:${markHeight}`}>
  <div class="world-hero__bg" aria-hidden="true"></div>
  <ElementHeroFX type={world} />

  <div class="world-hero__logo relative z-[2]">
    <span class="world-hero__glow" aria-hidden="true"></span>
    <img src={logo} alt={`${name} logo`} class="world-hero__mark" fetchpriority="high" />
  </div>
</section>

<Section class={`relative ${wvar}`}>
  <div class="world-hero__bg world-hero__bg--soft" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-[46rem] text-center" data-reveal>
    <span class="inline-flex items-center justify-center gap-2">
      <Icon name={elementIcon} size={18} class={accentText} />
      <Eyebrow tone={world}>{meta}</Eyebrow>
    </span>
    <Heading level={1} size="display-l" tone={world} class="mt-4">{heading}</Heading>
    <span class:list={["mx-auto mt-6 block h-1 w-16 rounded-full", accentLine]} aria-hidden="true"></span>
    <p class="mt-7 font-display text-heading-l text-foreground">{tagline}</p>
    <p class="mt-5 text-body-l text-muted">{intro}</p>
    {status === "Coming soon" && <p class="mt-6"><Eyebrow tone="subtle">Coming soon</Eyebrow></p>}
    {
      (primaryHref || secondaryHref) && (
        <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
          {primaryHref && <Button href={primaryHref} world={world} size="lg">{primaryLabel}</Button>}
          {secondaryHref && <Button href={secondaryHref} variant="secondary" size="lg">{secondaryLabel}</Button>}
        </div>
      )
    }
  </div>
</Section>

<style>
  .world-hero__bg {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 170%;
    height: 170%;
    transform: translate(-50%, -50%);
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(36rem 30rem at 50% 30%, color-mix(in srgb, var(--w) 18%, transparent), transparent 64%),
      radial-gradient(30rem 26rem at 22% 78%, color-mix(in srgb, var(--w) 12%, transparent), transparent 64%),
      radial-gradient(30rem 26rem at 80% 76%, color-mix(in srgb, var(--w) 12%, transparent), transparent 64%);
    animation: wh-drift 150s linear infinite;
  }
  .world-hero__bg--soft {
    width: 130%;
    height: 200%;
    opacity: 0.5;
    animation: none;
  }
  .world-hero__logo {
    opacity: 0;
    animation:
      wh-in 1.1s var(--ease-refined) both,
      wh-float 7s var(--ease-refined) 1.1s infinite;
  }
  .world-hero__glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150%;
    height: 180%;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, color-mix(in srgb, var(--w) 34%, transparent), transparent 72%);
    filter: blur(30px);
    z-index: -1;
  }
  .world-hero__mark {
    display: block;
    height: var(--mark-h, clamp(150px, 28vh, 300px));
    width: auto;
    max-width: 86vw;
    object-fit: contain;
  }
  @keyframes wh-drift { to { transform: translate(-50%, -50%) rotate(360deg); } }
  @keyframes wh-in { from { opacity: 0; scale: 0.86; } to { opacity: 1; scale: 1; } }
  @keyframes wh-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -12px; } }
</style>
