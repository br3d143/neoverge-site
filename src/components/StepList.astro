---
/**
 * StepList — numbered vertical step sequence (e.g. Admissions application steps).
 * A step may carry an action link (href + linkLabel) rendered under its body.
 */
import Heading from "./Heading.astro";

interface Props {
  steps: { title: string; body: string; href?: string; linkLabel?: string }[];
}
const { steps } = Astro.props;
---

<ol class="flex flex-col gap-xl">
  {
    steps.map((s, i) => (
      <li class="grid grid-cols-[auto_1fr] gap-6 border-t border-border pt-8 md:gap-10" data-reveal>
        <span class="font-display text-display-m text-subtle">{String(i + 1).padStart(2, "0")}</span>
        <div>
          {s.href ? (
            <a
              href={s.href}
              target={s.href.startsWith("http") ? "_blank" : undefined}
              rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="group inline-flex items-baseline gap-2 underline decoration-border-strong underline-offset-4 transition-colors duration-[250ms] hover:decoration-foreground"
            >
              <Heading level={3} size="heading-l">{s.title}</Heading>
              <span class="text-subtle transition-transform duration-[250ms] group-hover:translate-x-0.5 group-hover:text-foreground" aria-hidden="true">↗</span>
            </a>
          ) : (
            <Heading level={3} size="heading-l">{s.title}</Heading>
          )}
          <p class="mt-3 max-w-[44rem] text-body-m text-muted">{s.body}</p>
        </div>
      </li>
    ))
  }
</ol>
