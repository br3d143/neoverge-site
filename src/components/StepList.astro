---
/**
 * StepList — numbered vertical step sequence (e.g. Admissions application steps).
 */
import Heading from "./Heading.astro";

interface Props {
  steps: { title: string; body: string }[];
}
const { steps } = Astro.props;
---

<ol class="flex flex-col gap-xl">
  {
    steps.map((s, i) => (
      <li class="grid grid-cols-[auto_1fr] gap-6 border-t border-border pt-8 md:gap-10" data-reveal>
        <span class="font-display text-display-m text-subtle">{String(i + 1).padStart(2, "0")}</span>
        <div>
          <Heading level={3} size="heading-l">{s.title}</Heading>
          <p class="mt-3 max-w-[44rem] text-body-m text-muted">{s.body}</p>
        </div>
      </li>
    ))
  }
</ol>
