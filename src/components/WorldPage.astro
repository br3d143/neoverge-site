---
/**
 * WorldPage — full page template for a world (used by the coming-soon worlds:
 * NeoVerse, Pulse, WorldWise). Apex has its own richer page with photography.
 */
import Layout from "../layouts/Layout.astro";
import Section from "./Section.astro";
import Eyebrow from "./Eyebrow.astro";
import Heading from "./Heading.astro";
import WorldHero from "./WorldHero.astro";
import QuoteBlock from "./QuoteBlock.astro";
import ApplicationCTA from "./ApplicationCTA.astro";
import PhotoBand from "./PhotoBand.astro";
import { worldsContent, worldInstagram, worldFigures, worldPhotos, type WorldKey } from "../config/site";

interface Props {
  world: WorldKey;
}
const { world } = Astro.props;
const w = worldsContent[world];
const ig = worldInstagram[world];
const figures = worldFigures[world];
const photos = worldPhotos[world];

const tintBg = { earth: "bg-earth-tint", water: "bg-water-tint", fire: "bg-fire-tint", air: "bg-air-tint" }[world];
const dot = { earth: "bg-earth", water: "bg-water", fire: "bg-fire", air: "bg-air" }[world];
const waitlist = `mailto:${w.contact}?subject=Waitlist%20${encodeURIComponent(w.name)}`;

// Worlds with an open admissions page point their primary CTA there ("Apply now").
// The rest stay on the waitlist until their admissions open.
const admissionsHref: Partial<Record<WorldKey, string>> = { fire: "/admissions/pulse" };
const applyHref = admissionsHref[world] ?? waitlist;
const applyLabel = admissionsHref[world] ? "Apply now" : "Join the waitlist";
const ctaBody = admissionsHref[world]
  ? `${w.name} is now accepting early applications. Apply to join the founding cohort.`
  : `${w.name} is launching soon. Join the waitlist and we'll reach out with next steps.`;
---

<Layout title={`${w.name} — NeoVerge Dream School`} headerTransparent={true}>
  <WorldHero
    world={world}
    name={w.name}
    meta={w.grades}
    heading={w.heroHeading}
    tagline={w.tagline}
    intro={w.intro}
    status={w.status}
    logo={w.logo}
    primaryHref={applyHref}
    primaryLabel={applyLabel}
    secondaryHref={ig}
    secondaryLabel="Follow on Instagram"
  />

  <div class="relative isolate overflow-hidden">
    {/* Element figures (e.g. Pulse dancers) as faint page-background decoration */}
    {
      figures && figures.length > 0 && (
        <div class="wp-decor" aria-hidden="true">
          {figures.map((f, i) => (
            <img src={f} alt="" class={`wp-decor__fig wp-decor__fig--${i}`} loading="lazy" />
          ))}
        </div>
      )
    }

  <!-- Mission & Vision -->
  <Section class={tintBg}>
    <div class="grid grid-cols-1 gap-xl md:grid-cols-2 md:gap-lg" data-reveal>
      <QuoteBlock label="Our Mission">{w.mission}</QuoteBlock>
      <QuoteBlock label="Our Vision">{w.vision}</QuoteBlock>
    </div>
  </Section>

  <!-- What this world offers -->
  <Section>
    <div data-reveal>
      <Eyebrow tone={world}>What {w.name} offers</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3 max-w-[40rem]">A world built around how your child learns.</Heading>
    </div>
    {
      photos && photos.length > 0 ? (
        <div class="mt-2xl grid items-center gap-xl md:grid-cols-2 md:gap-2xl" data-reveal>
          <img
            src={photos[0].src}
            alt={photos[0].alt}
            loading="lazy"
            class:list={[
              photos[0].portrait ? "aspect-[3/4] max-w-[26rem] justify-self-center" : "aspect-[4/3]",
              "w-full rounded-3xl object-cover",
            ]}
          />
          <ul class="flex flex-col gap-lg">
            {w.offers.map((o) => (
              <li class="flex items-start gap-3 border-t border-border-strong pt-4">
                <span class:list={["mt-2 h-2 w-2 shrink-0 rounded-full", dot]} aria-hidden="true" />
                <span class="text-body-m text-foreground">{o}</span>
              </li>
            ))}
          </ul>
        </div>
      ) : (
        <ul class="mt-2xl grid gap-x-2xl gap-y-lg sm:grid-cols-2" data-reveal>
          {w.offers.map((o) => (
            <li class="flex items-start gap-3 border-t border-border-strong pt-4">
              <span class:list={["mt-2 h-2 w-2 shrink-0 rounded-full", dot]} aria-hidden="true" />
              <span class="text-body-m text-foreground">{o}</span>
            </li>
          ))}
        </ul>
      )
    }
  </Section>

  {/* Photography of life inside the world (else a coming-soon placeholder).
      The first photo is featured beside the offers list above, so the band
      below shows the remaining photos. */}
  {
    photos && photos.length > 0 ? (
      <Section>
        <div class="mx-auto max-w-[42rem] text-center" data-reveal>
          <Eyebrow tone={world}>Inside {w.name}</Eyebrow>
          <Heading level={2} size="display-m" class="mt-3">A glimpse of the everyday.</Heading>
        </div>
        <PhotoBand photos={photos.length > 1 ? photos.slice(1) : photos} class="mt-2xl" />
        <p class="mt-6 text-center text-body-s text-muted">Photos shown are illustrative; real {w.name} photography coming soon.</p>
      </Section>
    ) : (
      <Section space="compact">
        <div class:list={["flex aspect-[16/9] w-full items-center justify-center overflow-hidden rounded-3xl", tintBg]} data-reveal>
          <div class="flex flex-col items-center gap-4 text-center">
            <img src={w.logo} alt="" aria-hidden="true" class="max-h-24 w-auto opacity-30" />
            <Eyebrow tone="subtle">Photography coming soon</Eyebrow>
          </div>
        </div>
      </Section>
    )
  }

  <ApplicationCTA
    world={world}
    heading="Be first through the door."
    body={ctaBody}
    primaryHref={applyHref}
    primaryLabel={applyLabel}
    secondaryHref="/contact"
    secondaryLabel="Or get in touch"
  />
  </div>
</Layout>

<style>
  /* Faint element figures spread across the page as ambient background decoration */
  .wp-decor {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .wp-decor__fig {
    position: absolute;
    width: auto;
    opacity: 0.12;
    transform-origin: bottom center;
    animation: wp-sway 6s var(--ease-refined, ease-in-out) infinite;
  }
  .wp-decor__fig--0 {
    height: clamp(260px, 30vw, 480px);
    top: 30%;
    left: -5%;
    rotate: -4deg;
  }
  .wp-decor__fig--1 {
    height: clamp(300px, 34vw, 560px);
    top: 52%;
    right: -6%;
    rotate: 5deg;
    animation-delay: 0.9s;
  }
  .wp-decor__fig--2 {
    height: clamp(260px, 30vw, 480px);
    top: 76%;
    left: 4%;
    rotate: -2deg;
    animation-delay: 1.8s;
  }

  @keyframes wp-sway {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-10px) rotate(2.5deg); }
  }

  /* On smaller screens the page is narrow — hide decoration to avoid clutter */
  @media (max-width: 1024px) {
    .wp-decor { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wp-decor__fig { animation: none; }
  }
</style>
