---
/**
 * Container — centers content with the standard max-width and responsive gutters.
 * Gutters: 24px mobile, 48px tablet, 80px desktop (Section 4.3).
 */
interface Props {
  width?: "page" | "prose";
  as?: string;
  class?: string;
}
const { width = "page", as = "div", class: className = "" } = Astro.props;
const Tag = as;
const maxWidth = width === "prose" ? "max-w-[45rem]" : "max-w-page";
---

<Tag class:list={["mx-auto w-full px-6 sm:px-12 lg:px-20", maxWidth, className]}>
  <slot />
</Tag>
