---
/**
 * Mandala — the homepage signature: a radial four-world selector (brief Section 6).
 * Center wordmark + four compass nodes (N NeoVerse, E Pulse, S Apex, W WorldWise).
 * Entrance reveal, idle orbit drift + breathing, rich hover fill/halo, keyboard,
 * reduced-motion safe. Labels show the world name only (element lives in aria-label).
 */
const nodes = [
  { pos: "north", world: "earth", name: "NeoVerse", element: "Earth", href: "/worlds/neoverse" },
  { pos: "east", world: "fire", name: "Pulse", element: "Fire", href: "/worlds/pulse" },
  { pos: "south", world: "water", name: "Apex", element: "Water", href: "/worlds/apex" },
  { pos: "west", world: "air", name: "WorldWise", element: "Air", href: "/worlds/worldwise" },
];

const ring = {
  earth: "[--tint:var(--color-earth-tint)] [--accent:var(--color-earth-accent)] [--base:var(--color-earth)]",
  water: "[--tint:var(--color-water-tint)] [--accent:var(--color-water-accent)] [--base:var(--color-water)]",
  fire: "[--tint:var(--color-fire-tint)] [--accent:var(--color-fire-accent)] [--base:var(--color-fire)]",
  air: "[--tint:var(--color-air-tint)] [--accent:var(--color-air-accent)] [--base:var(--color-air)]",
};

const icons: Record<string, string> = {
  earth: `<path d="M12 21c0-6 3-10 8-12-1 6-4 10-8 12Zm0 0c0-6-3-10-8-12 1 6 4 10 8 12Zm0 0V9" />`,
  fire: `<path d="M12 3c2 3 5 5 5 9a5 5 0 0 1-10 0c0-1.5.6-2.8 1.5-3.7C9 10 11 8 12 3Z" />`,
  water: `<path d="M12 3c3.5 4.5 6 7.8 6 10.5a6 6 0 0 1-12 0C6 10.8 8.5 7.5 12 3Z" />`,
  air: `<path d="M3 9h11a3 3 0 1 0-3-3M3 14h15a3 3 0 1 1-3 3M3 12h9" />`,
};
---

<div class="mandala" role="group" aria-label="Choose your world">
  <div class="mandala__stage">
    <span class="mandala__glow" aria-hidden="true"></span>
    <span class="mandala__ring" aria-hidden="true"></span>

    <img
      src="/brand/neoverge-wordmark.png"
      alt="NeoVerge Dream School"
      width="2911"
      height="532"
      class="mandala__wordmark"
      fetchpriority="high"
    />

    {
      nodes.map((n) => (
        <a
          href={n.href}
          class:list={["mandala__node", `is-${n.pos}`, ring[n.world]]}
          aria-label={`Enter ${n.name}, the world of ${n.element}`}
        >
          <span class="mandala__circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[n.world]} />
          </span>
          <span class="mandala__label">{n.name}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .mandala {
    --r: clamp(104px, 32vw, 248px);
    --circle: clamp(64px, 17vw, 94px);
    display: flex;
    justify-content: center;
  }
  .mandala__stage {
    position: relative;
    width: calc(var(--r) * 2 + var(--circle) + 2.5rem);
    height: calc(var(--r) * 2 + var(--circle) + 2.5rem);
    max-width: 100%;
    animation: stage-in 1.1s var(--ease-refined) both;
  }

  /* soft lit backdrop for depth */
  .mandala__glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 135%;
    height: 135%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.9) 0%, rgba(250, 250, 247, 0) 60%);
    pointer-events: none;
  }

  .mandala__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    transform: translate(-50%, -50%);
    border: 1px dashed var(--color-border-strong);
    border-radius: 9999px;
    opacity: 0.45;
    transform-origin: center;
    animation: orbit 60s linear infinite;
  }
  .mandala:hover .mandala__ring {
    animation-play-state: paused;
  }

  .mandala__wordmark {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: clamp(116px, 26vw, 188px);
    height: auto;
  }

  .mandala__node {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--circle);
    height: var(--circle);
    text-decoration: none;
    outline: none;
    opacity: 0;
    animation: node-in 0.6s var(--ease-refined) both;
  }
  .is-north {
    transform: translate(-50%, -50%) translateY(calc(var(--r) * -1));
    animation-delay: 0.55s;
  }
  .is-east {
    transform: translate(-50%, -50%) translateX(var(--r));
    animation-delay: 0.7s;
  }
  .is-south {
    transform: translate(-50%, -50%) translateY(var(--r));
    animation-delay: 0.85s;
  }
  .is-west {
    transform: translate(-50%, -50%) translateX(calc(var(--r) * -1));
    animation-delay: 1s;
  }

  .mandala__circle {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 9999px;
    background: var(--color-surface);
    border: 1.5px solid color-mix(in srgb, var(--base) 45%, transparent);
    color: var(--accent);
    box-shadow: 0 6px 20px -12px color-mix(in srgb, var(--base) 40%, rgba(26, 26, 26, 0.22));
    transition:
      transform 250ms var(--ease-refined),
      background-color 250ms var(--ease-refined),
      color 250ms var(--ease-refined),
      box-shadow 250ms var(--ease-refined),
      border-color 250ms var(--ease-refined);
    animation: breathe 3s var(--ease-refined) infinite;
  }
  .mandala__circle svg {
    width: 42%;
    height: 42%;
  }
  .is-north .mandala__circle { animation-delay: 0s; }
  .is-east .mandala__circle { animation-delay: 0.75s; }
  .is-south .mandala__circle { animation-delay: 1.5s; }
  .is-west .mandala__circle { animation-delay: 2.25s; }

  .mandala__label {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 0.75rem;
    max-width: calc(var(--circle) * 2);
    font-family: var(--font-display);
    font-size: var(--text-eyebrow);
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-muted);
    white-space: nowrap;
    transition: color 250ms var(--ease-refined);
  }

  /* Hover + focus: fill with tint, recolor to accent, crisp ring + soft colored halo */
  .mandala:hover .mandala__circle { animation-play-state: paused; }
  .mandala__node:hover .mandala__circle,
  .mandala__node:focus-visible .mandala__circle {
    transform: scale(1.1);
    background: var(--tint);
    color: var(--accent);
    border-color: var(--base);
    box-shadow:
      0 0 0 1.5px var(--base),
      0 16px 38px -10px color-mix(in srgb, var(--base) 45%, transparent);
    animation-play-state: paused;
  }
  .mandala__node:hover .mandala__label,
  .mandala__node:focus-visible .mandala__label {
    color: var(--accent);
  }
  .mandala__node:focus-visible {
    outline: 2px solid var(--base);
    outline-offset: 7px;
    border-radius: 9999px;
  }
  .mandala__node:active .mandala__circle {
    transform: scale(1.04);
  }

  @keyframes orbit {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
  @keyframes breathe {
    0%, 100% { scale: 0.97; }
    50% { scale: 1.03; }
  }
  @keyframes stage-in {
    from { opacity: 0; transform: scale(0.92); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes node-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
