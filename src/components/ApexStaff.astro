---
/**
 * ApexStaff — the dark AISA staff-card band, built from the staff card PDFs in
 * OneDrive (photos extracted from the cards; teal duotone recreated in CSS).
 * Shown on both the Apex main page and /worlds/apex/staff per client request,
 * so staff-*.webp images are intentionally reused across those two pages.
 */
import Container from "./Container.astro";
import { worldInstagram } from "../config/site";

interface Props {
  heading?: string;
}
const { heading = "The staff behind the system." } = Astro.props;

type Stat = { value: string; label: string };
type Cred = { lead: string; rest?: string };

const staff: {
  name: string;
  role: string;
  sub?: string;
  bio: string;
  image: string;
  imagePosition?: string;
  statsLabel?: string;
  stats?: Stat[];
  credsLabel?: string;
  creds?: Cred[];
}[] = [
  {
    name: "Quincy Stinson",
    role: "Athletic Director",
    bio: "As one of AISA's Athletic Directors, Quincy brings the rare pedigree of an All-American and conference record holder, and the belief that hoops reflects life.",
    image: "/images/staff-quincy.webp",
    imagePosition: "center 20%",
    credsLabel: "Records & honors",
    creds: [
      { lead: "NABC All-American", rest: "(1999–2000)" },
      { lead: "First Cal State LA All-American", rest: "since 1984" },
      { lead: "CCAA all-time career steals", rest: "record holder (211)" },
      { lead: "4× All-CCAA selection", rest: "(2× First Team)" },
      { lead: "1,109 career points", rest: "top-10 all-time at Cal State LA" },
      { lead: "1996 CIF Southern Section Champion", rest: "at John Muir" },
    ],
  },
  {
    name: "Robert Icart",
    role: "Athletic Director",
    sub: "Founder & Executive Director, BTI",
    bio: "As AISA's Athletic Director, Robert leads our basketball program and college-placement pipeline, bringing the network and 25+ years he built at BTI to every Apex athlete.",
    image: "/images/staff-robert.webp",
    imagePosition: "center 20%",
    statsLabel: "Career track record · players placed",
    stats: [
      { value: "600+", label: "to college" },
      { value: "35", label: "to the Ivy League" },
      { value: "8", label: "to the NBA" },
    ],
  },
  {
    name: "Donovan Morris",
    role: "Boys Head Coach",
    bio: "As AISA's Boys Head Coach, Donovan walks our players through the same pipeline he walked himself: prep school, Division 1, and seven pro years across five countries.",
    image: "/images/staff-donovan.webp",
    statsLabel: "Career highlights",
    stats: [
      { value: "2,000+", label: "#1 all-time scorer, Cajon HS" },
      { value: "D1", label: "Fresno State · Long Beach State" },
      { value: "7", label: "pro years, 5 countries" },
    ],
  },
  {
    name: "Geoff Vaughn",
    role: "Master Trainer",
    sub: "Performance, Strength & Agility",
    bio: "As AISA's master performance trainer, Geoff runs the same development pipeline he built at home, one that carried his own brothers from backyard training sessions to USC, UCLA, and the NFL.",
    image: "/images/staff-geoff.webp",
    imagePosition: "center",
    credsLabel: "Career highlights",
    creds: [
      { lead: "Mentored Tyler Vaughns from age 7", rest: "standout USC receiver → NFL pro" },
      { lead: "Developed JonJon Vaughns", rest: "rare two-sport D1 athlete at UCLA" },
      { lead: "Field Manager, Los Angeles region", rest: "Team California Baseball, an elite SoCal prep program" },
      { lead: "Coaches & evaluates top-tier prep talent", rest: "as a Team California roving instructor" },
      { lead: "Collegiate defensive back", rest: "for powerhouse Mt. San Antonio College" },
      { lead: "Player of the Year honors", rest: "as a two-sport varsity standout at South Hills HS" },
    ],
  },
  {
    name: "Dr. Shayna Markwongnark",
    role: "Director of Education",
    bio: "As AISA's Director of Education, Shayna leads our accredited academic program, bringing the work of a USC professor and a doctorate in education to every Apex student-athlete.",
    image: "/images/staff-shayna.webp",
    imagePosition: "center 25%",
    credsLabel: "Education & credentials",
    creds: [
      { lead: "Doctorate in Educational Leadership (EdD)", rest: "USC" },
      { lead: "Professor of Clinical Education", rest: "USC Rossier School of Education" },
      { lead: "Certified mindset coach", rest: "for student-athletes" },
    ],
  },
  {
    name: "Jordan Hill",
    role: "Skills Trainer",
    bio: "As AISA's Skills Trainer, Jordan develops our guards with the discipline he built at college basketball's highest level, and later as a pro overseas.",
    image: "/images/staff-jordan.webp",
    credsLabel: "Playing career",
    creds: [
      { lead: "Played D1", rest: "at Wisconsin & Seattle University" },
      { lead: "Wisconsin Final Four", rest: "team member" },
      { lead: "Played professionally", rest: "overseas in Cyprus" },
    ],
  },
  {
    name: "Mike Teller",
    role: "Skills Trainer",
    sub: "Owner, The Secret Trainer",
    bio: "As AISA's Skills Trainer and owner of The Secret Trainer, Mike brings pro-level skill development to every Apex player, turning detail and daily reps into real improvement.",
    image: "/images/staff-teller.webp",
    credsLabel: "Trainer credentials",
    creds: [
      { lead: "21+ years", rest: "as a top West Coast skills trainer" },
      { lead: "Head coach of BTI United", rest: "BTI's top circuit team" },
      { lead: "Pangos All-American Camp", rest: "coach" },
    ],
  },
];

const ig = worldInstagram.water;
---

<section class="bg-[#0d1517]">
  <Container class="py-2xl md:py-3xl">
    <div data-reveal>
      <p class="font-body text-eyebrow uppercase tracking-[0.14em] text-water-light">AISA · Staff</p>
      <h2 class="mt-3 max-w-[40rem] font-display text-heading-l text-white md:text-display-m">
        {heading}
      </h2>
    </div>

    <div class="mt-2xl grid grid-cols-1 gap-6 md:grid-cols-2">
      {staff.map((p) => (
        <article
          id={p.name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}
          class="staff-card flex scroll-mt-24 flex-col overflow-hidden rounded-3xl ring-1 ring-white/10"
          data-reveal
        >
          <div class="staff-photo relative aspect-[4/3]">
            <img
              src={p.image}
              alt={`${p.name}, ${p.role}`}
              width="1600"
              height="1216"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover"
              style={`object-position: ${p.imagePosition ?? "center 30%"}`}
            />
            <div class="staff-photo__tint" aria-hidden="true"></div>
            <div class="staff-photo__fade" aria-hidden="true"></div>
            <span class="staff-chip">● AISA · Staff</span>
          </div>
          <div class="flex grow flex-col gap-5 border-t-2 border-water-light/70 p-7 md:p-8">
            <div>
              <p class="font-body text-eyebrow uppercase tracking-[0.14em] text-water-light">{p.role}</p>
              <h3 class="mt-2 font-display text-heading-l text-white">{p.name}</h3>
              {p.sub && <p class="mt-1.5 text-body-s text-white/55">{p.sub}</p>}
            </div>
            <p class="text-body-m text-white/75">{p.bio}</p>
            <div class="mt-auto border-t border-white/10 pt-5">
              {p.stats ? (
                <>
                  <p class="font-body text-[11px] uppercase tracking-[0.16em] text-water-light/80">{p.statsLabel}</p>
                  <dl class="mt-4 grid grid-cols-3 gap-4">
                    {p.stats.map((s) => (
                      <div>
                        <dd class="font-display text-[2rem] leading-none text-water-light">{s.value}</dd>
                        <dt class="mt-2 text-[11px] uppercase leading-snug tracking-wider text-white/50">{s.label}</dt>
                      </div>
                    ))}
                  </dl>
                </>
              ) : (
                <>
                  <p class="font-body text-[11px] uppercase tracking-[0.16em] text-water-light/80">{p.credsLabel}</p>
                  <ul
                    class:list={[
                      "mt-4 gap-3",
                      p.creds!.length > 3 ? "grid grid-cols-1 sm:grid-cols-2" : "flex flex-col",
                    ]}
                  >
                    {p.creds!.map((c) => (
                      <li class="flex items-start gap-3">
                        <span class="mt-[0.55em] h-[2px] w-4 shrink-0 bg-water-light" aria-hidden="true" />
                        <span class="text-body-s text-white/70">
                          <strong class="font-semibold text-white">{c.lead}</strong>
                          {c.rest && ` ${c.rest}`}
                        </span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>
            <a
              href={ig}
              target="_blank"
              rel="noopener noreferrer"
              class="text-body-s text-white/40 transition-colors hover:text-water-light"
            >@apexinnersystemathletics</a>
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>

<style>
  .staff-card {
    background: #131c1f;
  }
  /* Recreate the staff cards' teal duotone: colorize the B&W photo, then deepen */
  .staff-photo__tint {
    position: absolute;
    inset: 0;
    background: var(--color-water, #5da9b3);
    mix-blend-mode: color;
  }
  .staff-photo__fade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(13, 21, 23, 0.55), rgba(13, 21, 23, 0) 38%),
      rgba(12, 45, 51, 0.28);
    mix-blend-mode: multiply;
  }
  .staff-chip {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(13, 21, 23, 0.35);
    backdrop-filter: blur(4px);
  }
</style>
