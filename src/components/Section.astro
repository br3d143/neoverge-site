---
/**
 * Section — a page section with consistent vertical rhythm (Section 4.3).
 * Vertical padding: 96px mobile, 128px tablet, 192px desktop.
 * By default wraps its content in a Container; pass `contained={false}` to opt out.
 */
import Container from "./Container.astro";

interface Props {
  id?: string;
  as?: string;
  contained?: boolean;
  width?: "page" | "prose";
  /** Vertical padding preset. "default" = airy section rhythm; "compact" = tighter. */
  space?: "default" | "compact" | "none";
  class?: string;
}
const {
  id,
  as = "section",
  contained = true,
  width = "page",
  space = "default",
  class: className = "",
} = Astro.props;
const Tag = as;
const spaceClasses = {
  default: "py-2xl md:py-3xl lg:py-4xl",
  compact: "py-xl md:py-2xl",
  none: "",
}[space];
---

<Tag id={id} class:list={[spaceClasses, className]}>
  {
    contained ? (
      <Container width={width}>
        <slot />
      </Container>
    ) : (
      <slot />
    )
  }
</Tag>
