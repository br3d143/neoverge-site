---
/**
 * WorldCard — scannable card for the homepage "or pick from below" grid.
 * Element dot + world name + status label (matches the Worlds dropdown) + arrow.
 * Subtle lift on hover.
 */
interface Props {
  world: "earth" | "water" | "fire" | "air";
  name: string;
  label?: string; // status label, e.g. "Enroll now" / "Coming Fall 2026" / "Coming soon"
  href: string;
  status?: "Active" | "Coming soon";
  emphasize?: boolean; // bold the label (Apex "Enroll now", Pulse date)
}
const { world, name, label, href, status, emphasize = false } = Astro.props;

const dot = {
  earth: "bg-earth",
  water: "bg-water",
  fire: "bg-fire",
  air: "bg-air",
}[world];
const hoverBorder = {
  earth: "hover:border-earth/60",
  water: "hover:border-water/60",
  fire: "hover:border-fire/60",
  air: "hover:border-air/60",
}[world];
---

<a
  href={href}
  class:list={[
    "group flex items-center gap-4 rounded-2xl border border-border bg-surface px-5 py-4 transition-all duration-[250ms] [transition-timing-function:var(--ease-refined)] hover:-translate-y-0.5 hover:shadow-[0_12px_40px_-16px_rgba(26,26,26,0.25)]",
    hoverBorder,
  ]}
>
  <span class:list={["h-2.5 w-2.5 shrink-0 rounded-full", dot]} aria-hidden="true"></span>
  <span class="min-w-0 font-display text-heading-s text-foreground">{name}</span>
  {
    label && (
      <span
        class:list={[
          "ml-auto shrink-0 whitespace-nowrap font-body text-eyebrow uppercase",
          emphasize ? "font-semibold text-foreground" : "text-subtle",
        ]}
      >
        {label}
      </span>
    )
  }
  <span
    class:list={[
      "shrink-0 font-display text-heading-s text-subtle transition-transform duration-[250ms] group-hover:translate-x-1 group-hover:text-foreground",
      label ? "ml-3" : "ml-auto",
    ]}
    aria-hidden="true"
  >→</span>
</a>
