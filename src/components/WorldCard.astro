---
/**
 * WorldCard — scannable card for the homepage fallback grid and worlds overview.
 * Element dot + world name + element/focus eyebrow + arrow. Subtle lift on hover.
 */
interface Props {
  world: "earth" | "water" | "fire" | "air";
  name: string;
  meta: string; // e.g. "EARTH · K–8 ACADEMICS"
  href: string;
  status?: "Active" | "Coming soon";
}
const { world, name, meta, href, status } = Astro.props;

const dot = {
  earth: "bg-earth",
  water: "bg-water",
  fire: "bg-fire",
  air: "bg-air",
}[world];
const hoverBorder = {
  earth: "hover:border-earth/60",
  water: "hover:border-water/60",
  fire: "hover:border-fire/60",
  air: "hover:border-air/60",
}[world];
---

<a
  href={href}
  class:list={[
    "group flex items-center gap-4 rounded-2xl border border-border bg-surface px-5 py-4 transition-all duration-[250ms] [transition-timing-function:var(--ease-refined)] hover:-translate-y-0.5 hover:shadow-[0_12px_40px_-16px_rgba(26,26,26,0.25)]",
    hoverBorder,
  ]}
>
  <span class:list={["h-2.5 w-2.5 shrink-0 rounded-full", dot]} aria-hidden="true"></span>
  <span class="flex flex-col">
    <span class="font-display text-heading-s text-foreground">{name}</span>
    <span class="font-body text-eyebrow uppercase text-subtle">{meta}</span>
  </span>
  {
    status === "Coming soon" && (
      <span class="ml-auto hidden font-body text-eyebrow uppercase text-subtle sm:inline">
        Coming soon
      </span>
    )
  }
  <span
    class:list={[
      "font-display text-heading-s text-subtle transition-transform duration-[250ms] group-hover:translate-x-1 group-hover:text-foreground",
      status === "Coming soon" ? "ml-2" : "ml-auto",
    ]}
    aria-hidden="true"
  >→</span>
</a>
