---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Section from "../../components/Section.astro";
import SplitSection from "../../components/SplitSection.astro";
import Container from "../../components/Container.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Heading from "../../components/Heading.astro";
import Prose from "../../components/Prose.astro";
import StepList from "../../components/StepList.astro";
import FAQ from "../../components/FAQ.astro";
import ApplicationCTA from "../../components/ApplicationCTA.astro";
import Link from "../../components/Link.astro";
import { forms, worldsContent, worldInstagram } from "../../config/site";

const w = worldsContent.fire;

// NOTE: Pulse launches Fall 2026, so the steps below describe an audition-based
// performing-arts process. Confirm/replace these with Shaun's real process when
// available. Tuition is intentionally left as "to be announced", no numbers invented.
const steps = [
  { title: "Submit the Pulse Interest Form", body: "Tell us about your young artist, their disciplines, experience, and what draws them to Pulse. This is the first step toward a spot in our Fall 2026 launch cohort.", href: forms.pulseInterest },
  { title: "Audition or Portfolio Review", body: "Artists share their craft through a live or recorded audition in dance, musical theatre, or acting, or a portfolio review. This is about potential and passion, not perfection." },
  { title: "Family & Student Interview", body: "We sit down with the family to talk goals, schedule, and academic needs, and to make sure Pulse is the right home for your artist's growth." },
  { title: "Acceptance Notification", body: "You'll receive an official email with your status. Accepted artists move on to enrollment and join the founding Pulse community." },
  { title: "Enrollment & Registration", body: "Complete enrollment paperwork and registration to secure your place. You'll receive a welcome packet with schedules, expectations, and onboarding steps." },
];

const faqs = [
  { q: "What is Pulse Collective?", a: "Pulse is NeoVerge's performing-arts world, a bold, supportive home where young artists train in dance, musical theatre, and acting while receiving personalized academic instruction on an artist's schedule." },
  { q: "What ages or grade levels do you serve?", a: "Pulse is designed for performing artists in grades K–12. Placement considers age, experience, and discipline." },
  { q: "What disciplines can my child study?", a: "Dance (ballet, jazz, lyrical, contemporary, hip hop, and tap), musical theatre, and acting, with storytelling, monologue work, performance showcases, and cross-disciplinary projects." },
  { q: "Is an audition required?", a: "Yes, every artist completes an audition or portfolio review. It's a welcoming process focused on passion and potential, not a high-pressure tryout." },
  { q: "How do academics work at Pulse?", a: "Pulse blends performing-arts training with personalized academics built around a young artist's rehearsal and performance schedule, so creativity and learning grow together." },
  { q: "How much is tuition?", a: "Tuition for the Fall 2026 launch will be shared with families during the application process. Payment plan options will be available." },
  { q: "When does Pulse open?", a: "Pulse Collective launches Fall 2026. Early applications are open now for families who want to be part of the founding cohort." },
  { q: "How do I apply?", a: "Start with the Pulse Interest Form. You'll then be invited to an audition or portfolio review, followed by a family interview before enrollment." },
];
---

<Layout title="Pulse Collective Admissions, NeoVerge Dream School" headerTransparent={true}>
  <PageHero
    world="fire"
    eyebrow="Pulse Collective · Admissions"
    title="Take center stage."
    intro="Pulse Collective launches Fall 2026, and early applications are open now. If your young artist lives to move, perform, and create, this is where their spark becomes a craft. Apply to join our founding cohort."
    image="/images/stock/dance-teens.webp"
    imageAlt="Young performers in a dance class"
    imageAspect="aspect-[4/5]"
  />

  <Container class="pt-6">
    <Link href="/admissions" tone="muted" class="text-body-s">← All NeoVerge admissions</Link>
  </Container>

  <!-- Coming soon notice -->
  <SplitSection world="fire" eyebrow="Now accepting early applications" heading="Be part of the founding cohort.">
    <Prose centered={false}>
      <p>Pulse Collective opens its doors in Fall 2026. Families who apply early help shape the very first Pulse community, and get a head start on auditions, placement, and enrollment. There's no better time to step into the spotlight.</p>
      <p>Questions about applying? Reach us anytime at <strong>{w.contact}</strong>, or follow <a href={worldInstagram.fire} target="_blank" rel="noopener noreferrer">@pulsecollectivefire</a> for the latest.</p>
    </Prose>
  </SplitSection>

  <!-- Photography -->
  <Section space="compact">
    <figure data-reveal>
      <img
        src="/images/stock/pulse-2.webp"
        width="1400"
        height="2100"
        alt="Young dancers learning at the barre"
        loading="lazy"
        class="aspect-[3/2] w-full rounded-3xl object-cover object-[center_70%]"
      />
      <figcaption class="mt-4 text-center">
        <Eyebrow tone="subtle">Where passion becomes craft</Eyebrow>
      </figcaption>
    </figure>
  </Section>

  <!-- Application steps -->
  <Section class="border-t border-border">
    <div data-reveal>
      <Eyebrow tone="fire">The process</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3">Your path to Pulse, step by step.</Heading>
    </div>
    <div class="mt-2xl">
      <StepList steps={steps} />
    </div>
  </Section>

  <!-- What Pulse offers -->
  <Section class="border-t border-border">
    <div data-reveal>
      <Eyebrow tone="fire">What's included</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3 max-w-[40rem]">Training, performance, and personalized academics.</Heading>
    </div>
    <ul class="mt-2xl grid gap-x-2xl gap-y-lg sm:grid-cols-2" data-reveal>
      {w.offers.map((o) => (
        <li class="flex items-start gap-3 border-t border-border-strong pt-4">
          <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-fire" aria-hidden="true" />
          <span class="text-body-m text-foreground">{o}</span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Tuition (numbers to be announced for the Fall 2026 launch) -->
  <Section class="border-t border-border">
    <div class="grid grid-cols-1 gap-xl md:grid-cols-2 md:gap-2xl">
      <div data-reveal>
        <Eyebrow tone="muted">Tuition · 2026–2027</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3">Investing in your artist.</Heading>
        <p class="mt-6 text-body-l text-muted">Tuition and fees for the Fall 2026 launch will be shared with families during the application process, along with available payment plan options.</p>
      </div>
      <div data-reveal>
        <Eyebrow tone="muted">Good to know</Eyebrow>
        <ul class="mt-xl flex flex-col gap-4">
          {[
            "Early applications are open now for the founding cohort",
            "Placement is by audition or portfolio review",
            "Personalized academics on an artist's schedule",
            "Performance showcases throughout the year",
          ].map((o) => (
            <li class="flex items-start gap-3 border-t border-border-strong pt-4">
              <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-fire" aria-hidden="true" />
              <span class="text-body-m text-foreground">{o}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- FAQs -->
  <SplitSection world="fire" eyebrow="Admissions FAQs" heading="Questions, answered." class="border-t border-border">
    <FAQ items={faqs} />
  </SplitSection>

  <ApplicationCTA
    world="fire"
    heading="Ready to shine?"
    body="Apply now to join the founding Pulse Collective cohort, launching Fall 2026."
    primaryHref={forms.pulseInterest}
    primaryLabel="Start your application"
    secondaryHref="/contact"
    secondaryLabel="Or get in touch"
  />
</Layout>
