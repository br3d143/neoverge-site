---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Heading from "../components/Heading.astro";
import Button from "../components/Button.astro";
import ApplicationCTA from "../components/ApplicationCTA.astro";
import { worldsContent, worldOrder, type WorldKey } from "../config/site";

// Per-world admissions status. Apex + Pulse are open; the others are coming soon.
const admissions: Record<WorldKey, { href: string | null; open: boolean }> = {
  water: { href: "/admissions/apex", open: true },
  fire: { href: "/admissions/pulse", open: true },
  earth: { href: null, open: false },
  air: { href: null, open: false },
};

const tint = { earth: "bg-earth-tint", water: "bg-water-tint", fire: "bg-fire-tint", air: "bg-air-tint" };
const dot = { earth: "bg-earth", water: "bg-water", fire: "bg-fire", air: "bg-air" };
const tone = { earth: "earth", water: "water", fire: "fire", air: "air" } as const;
---

<Layout title="Admissions, NeoVerge Dream School" headerTransparent={true}>
  <PageHero
    eyebrow="Admissions"
    title="Find your world, then apply."
    intro="NeoVerge is one universe of four worlds, and each one admits students its own way. Choose the world that fits your child and start your application below. Apex and Pulse Collective are accepting applications now; our other worlds are opening soon."
    image="/images/stock/community.webp"
    imageAlt="A diverse group of NeoVerge students together"
  />

  <Section>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2" data-reveal>
      {
        worldOrder.map((k) => {
          const w = worldsContent[k];
          const a = admissions[k];
          return (
            <div class="flex flex-col overflow-hidden rounded-3xl border border-border bg-surface">
              <div class:list={["flex aspect-[16/9] items-center justify-center p-10", tint[k]]}>
                <img src={w.logo} alt={`${w.name} logo`} class="max-h-24 w-auto object-contain" loading="lazy" />
              </div>
              <div class="flex flex-1 flex-col p-7">
                <div class="flex items-center gap-2.5">
                  <span class:list={["h-2.5 w-2.5 shrink-0 rounded-full", dot[k]]} aria-hidden="true" />
                  <Eyebrow tone={tone[k]}>{w.element} · {w.grades}</Eyebrow>
                </div>
                <Heading level={2} size="heading-l" class="mt-3">{w.name}</Heading>
                <p class="mt-3 flex-1 text-body-m text-muted">{w.blurb}</p>
                <div class="mt-7">
                  {a.open && a.href ? (
                    <Button href={a.href} world={k}>Apply to {w.name.split(" ")[0]} →</Button>
                  ) : (
                    <span class="inline-flex items-center gap-2 rounded-full border border-border-strong px-4 py-2 font-body text-eyebrow uppercase text-subtle">
                      Admissions opening soon
                    </span>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </Section>

  <!-- How admissions works (shared overview) -->
  <Section class="border-t border-border bg-surface">
    <div class="mx-auto max-w-[44rem] text-center" data-reveal>
      <Eyebrow tone="muted">How it works</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3">One school, many doors in.</Heading>
      <p class="mt-5 text-body-l text-muted">
        Each world has its own process built around what it teaches, athletic Shadow Days for Apex,
        auditions for Pulse, and more to come. Pick your world above to see its exact steps, what's
        included, and how to apply. Not sure which fits? We're happy to help you find the right one.
      </p>
      <div class="mt-xl flex flex-wrap items-center justify-center gap-5">
        <Button href="/contact" size="lg">Talk to our team</Button>
      </div>
    </div>
  </Section>

  <ApplicationCTA
    heading="Your journey starts here."
    body="Choose a world above to begin, or reach out and we'll help you find the right fit."
    primaryHref="/contact"
    primaryLabel="Get in touch"
    secondaryHref="/worlds"
    secondaryLabel="Explore the worlds"
  />
</Layout>
