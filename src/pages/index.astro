---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Heading from "../components/Heading.astro";
import Button from "../components/Button.astro";
import Link from "../components/Link.astro";
import Divider from "../components/Divider.astro";
import Mandala from "../components/Mandala.astro";
import WorldCard from "../components/WorldCard.astro";
import QuoteBlock from "../components/QuoteBlock.astro";
import Testimonials from "../components/Testimonials.astro";
import Constellation from "../components/Constellation.astro";
import PhotoBand from "../components/PhotoBand.astro";
import SplitSection from "../components/SplitSection.astro";
import Icon from "../components/Icon.astro";

// Labels match the Worlds dropdown menu (see `worlds` in config/site.ts).
const cards = [
  { world: "earth", name: "NeoVerse", label: "Coming soon", href: "/worlds/neoverse", status: "Coming soon", emphasize: false },
  { world: "water", name: "Apex Inner System Athletics", label: "Enroll now", href: "/worlds/apex", status: "Active", emphasize: true },
  { world: "fire", name: "Pulse Collective", label: "Coming Fall 2026", href: "/worlds/pulse", status: "Coming soon", emphasize: true },
  { world: "air", name: "WorldWise", label: "Coming soon", href: "/worlds/worldwise", status: "Coming soon", emphasize: false },
] as const;

const pillars = [
  { title: "One Vision, Many Pathways", icon: "compass", iconColor: "text-water-accent", body: "Whether your child thrives in the arts, academics, athletics, or global exploration, our four immersive worlds meet them where they are and help them grow." },
  { title: "Whole-Child Approach", icon: "heart", iconColor: "text-fire-accent", body: "We nurture the mind, body, and spirit through a curriculum that balances intellectual challenge, emotional intelligence, physical movement, and creative expression." },
  { title: "Cohort-Based Communities", icon: "users", iconColor: "text-earth-accent", body: "Students belong to mission-driven cohorts, NeoVerse, Apex, Pulse Collective, and WorldWise, each with its own culture, colors, and calling." },
];

const worldPanels = [
  { world: "earth", name: "NeoVerse", meta: "K–8 Academics", tagline: "Grounded in purpose. Growing with power.", desc: "Rigorous academics and rich enrichment for K–8 explorers, from garden science and project-based learning to languages, music, and wellness.", href: "/worlds/neoverse", logo: "/brand/neoverse.png", status: "Coming soon" },
  { world: "water", name: "Apex Inner System Athletics", meta: "Grades 6–12 + Post-Grad", tagline: "Flow with focus. Train with heart.", desc: "Elite training, mindset coaching, and NCAA-aligned academics that prepare student-athletes to lead in competition and in life.", href: "/worlds/apex", logo: "/brand/apex.png", status: "Active" },
  { world: "fire", name: "Pulse Collective", meta: "Performing Arts (K–12)", tagline: "Ignite your spark. Move with meaning.", desc: "A bold performing-arts world where young artists shine in dance, musical theatre, and acting alongside personalized academics.", href: "/worlds/pulse", logo: "/brand/pulse.png", status: "Coming soon" },
  { world: "air", name: "WorldWise", meta: "K–12 Hybrid", tagline: "Freedom to learn. Space to soar.", desc: "Flexible, community-driven learning for independent K–12 homeschool families and curious global learners.", href: "/worlds/worldwise", logo: "/brand/worldwise.png", status: "Coming soon" },
] as const;

const testimonials = [
  { quote: "Before Apex, I was working hard but not working smart. Now I've got a game plan for my sport, my education, and my life.", name: "Shaun Stinson", initials: "SS", image: "/images/headshot-shaun.webp" },
  { quote: "The coaches, mentors, and teachers here actually care. Apex changed my grind into something greater, something with purpose.", name: "Jake Vasquez", initials: "JV", image: "/images/headshot-jake.webp" },
  { quote: "This program gave me more than skills, it gave me vision. I now see college and success as something I can reach, not just dream about.", name: "Sahar Filler", initials: "SF", image: "/images/headshot-sahar.webp" },
  { quote: "At Apex, I found a family that pushes me to be my best on the court and in the classroom. They believe in me even when I doubt myself.", name: "Giorgi Shalikiani", initials: "GS", image: "/images/headshot-giorgi.webp" },
  { quote: "Apex didn't just train my body, it trained my mindset. I came in as an athlete, but I'll be leaving as a leader.", name: "Elijah Sumi", initials: "ES", image: "/images/headshot-elijah.webp" },
];

const linkTone = { earth: "earth", water: "water", fire: "fire", air: "air" } as const;
const tintBg = {
  earth: "bg-earth-tint",
  water: "bg-water-tint",
  fire: "bg-fire-tint",
  air: "bg-air-tint",
};
---

<Layout
  title="NeoVerge Dream School, One Universe. Infinite Futures."
  headerTransparent={true}
>
  <!-- Hero: the elemental mark + oversized tagline -->
  <section class="hero relative isolate flex min-h-[100dvh] flex-col items-center justify-center gap-6 overflow-hidden px-6 pt-24 pb-16 text-center">
    <div class="hero__bg" aria-hidden="true"></div>
    <Constellation />
    <div class="hero__logo" aria-hidden="true">
      <img
        src="/brand/neoverge-circle.png"
        width="1619"
        height="1615"
        alt=""
        class="hero__mark"
        fetchpriority="high"
      />
    </div>
    <h1 class="hero__title font-display text-display-l text-foreground md:text-display-xl">
      <span class="hero__line">One Universe.</span>
      <span class="hero__line">Infinite Futures.</span>
    </h1>
    <p class="hero__intro mx-auto max-w-[46rem] text-body-l text-muted">
      Welcome to NeoVerge Dream School. A visionary learning universe where passion meets
      purpose. We offer four immersive worlds of education designed to nurture every student's
      gifts and guide them toward meaningful futures. Whether your child is an earth-loving
      academic explorer, a creative performer, a committed athlete, or a curious global learner,
      NeoVerge is where they belong.
    </p>
    <a
      href="#worlds"
      class="hero__cue group inline-flex items-center gap-2 font-body text-eyebrow uppercase text-subtle transition-colors duration-[250ms] hover:text-foreground"
    >
      Choose your world
      <span class="transition-transform duration-[250ms] group-hover:translate-y-0.5" aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- Worlds: the interactive mandala + fallback cards -->
  <Section id="worlds">
    <div class="text-center" data-reveal>
      <Eyebrow tone="muted">Four worlds · One universe</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3">Choose your world</Heading>
    </div>
    <div class="mt-2xl" data-reveal>
      <Mandala />
    </div>
    <div class="mx-auto mt-3xl max-w-[52rem]">
      <Divider label="Or pick from below" class="mx-auto max-w-[28rem]" />
      <div class="mt-xl grid grid-cols-1 gap-4 sm:grid-cols-2">
        {cards.map((c) => <WorldCard world={c.world} name={c.name} label={c.label} href={c.href} status={c.status} emphasize={c.emphasize} />)}
      </div>
    </div>
  </Section>

  <!-- Why NeoVerge, three editorial pillars -->
  <Section class="bg-surface">
    <div class="grid items-center gap-xl md:grid-cols-2 md:gap-2xl" data-reveal>
      <div>
        <Eyebrow tone="muted">Why NeoVerge</Eyebrow>
        <Heading level={2} size="display-l" class="mt-4">
          Passion-driven, individualized learning.
        </Heading>
        <p class="mt-5 text-body-l text-muted">
          Every child learns differently. NeoVerge is built around that truth, one universe of
          four worlds, each shaped to the way your child thinks, moves, and dreams.
        </p>
      </div>
      <div>
        <img
          src="/images/stock/teacher-class.webp"
          width="1200"
          height="900"
          alt="A smiling teacher welcoming questions from her class"
          loading="lazy"
          class="aspect-[4/3] w-full rounded-3xl object-cover"
        />
      </div>
    </div>
    <div class="mt-3xl grid grid-cols-1 gap-x-lg gap-y-xl md:grid-cols-3" data-reveal>
      {
        pillars.map((p) => (
          <div class="border-t border-border-strong pt-6">
            <Icon name={p.icon} size={28} class={p.iconColor} />
            <Heading level={3} size="heading-l" class="mt-4">{p.title}</Heading>
            <p class="mt-3 text-body-m text-muted">{p.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Four-world reveal (logos shown clearly in their element-colored cards) -->
  <section aria-label="The four worlds">
    {
      worldPanels.map((w, i) => (
        <div class="border-t border-border py-2xl md:py-3xl">
          <div class="mx-auto w-full max-w-page px-6 sm:px-12 lg:px-20">
            <div class="grid items-center gap-xl md:grid-cols-2 md:gap-2xl">
              <div class:list={["flex justify-center", i % 2 === 1 && "md:order-2"]} data-reveal>
                <div class:list={["flex aspect-[4/3] w-full max-w-[26rem] items-center justify-center rounded-3xl p-10", tintBg[w.world]]}>
                  <img src={w.logo} alt={`${w.name} logo`} class="max-h-full max-w-full object-contain" loading="lazy" />
                </div>
              </div>
              <div class:list={["max-w-[36rem]", i % 2 === 1 && "md:order-1"]} data-reveal>
                <Eyebrow tone={linkTone[w.world]}>{w.meta}</Eyebrow>
                <Heading level={2} size="display-m" tone={w.world} class="mt-3">{w.name}</Heading>
                <p class="mt-4 font-display text-heading-m text-foreground">{w.tagline}</p>
                <p class="mt-4 text-body-l text-muted">{w.desc}</p>
                <div class="mt-7 flex items-center gap-4">
                  <Button href={w.href} variant="tertiary" world={w.world}>
                    {w.status === "Active" ? "Enter this world" : "Explore this world"}
                  </Button>
                  {w.status === "Coming soon" && (
                    <span class="font-body text-eyebrow uppercase text-subtle">Coming soon</span>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <!-- Life at NeoVerge, community photography -->
  <Section class="border-t border-border">
    <div class="mx-auto max-w-[44rem] text-center" data-reveal>
      <Eyebrow tone="muted">Life at NeoVerge</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3">One community, many kinds of brilliant.</Heading>
    </div>
    <div data-reveal>
      <PhotoBand
        photos={[
          { src: "/images/stock/community.webp", alt: "NeoVerge students together" },
          { src: "/images/stock/classroom-globe.webp", alt: "A teacher and students exploring the world together" },
          { src: "/images/stock/students-walking.webp", alt: "Students walking together on campus" },
        ]}
        class="mt-2xl"
      />
      <p class="mt-6 text-center text-body-s text-subtle">Photos shown are illustrative; real NeoVerge photography coming soon.</p>
    </div>
  </Section>

  <!-- Educational philosophy -->
  <SplitSection
    eyebrow="Our Philosophy"
    heading="Transformational, not transactional."
    class="border-t border-border"
  >
    <div class="flex flex-col gap-6 text-body-l text-foreground">
      <p>
        At NeoVerge, we create a constellation of learning experiences that honor student
        voice, ignite curiosity, and develop critical thinkers and self-led learners who are
        driven to pursue their individual passions.
      </p>
      <p>
        Rooted in our unique four-world model, we nurture the whole child, academically,
        artistically, athletically, and emotionally, while fostering the confidence,
        creativity, and resilience students need to become purposeful problem-solvers.
      </p>
      <p class="border-l-2 border-border-strong pl-6 font-display text-heading-l text-foreground">
        We don't just prepare students for the future. We help them build it in order to
        lead it.
      </p>
    </div>
  </SplitSection>

  <!-- Mission & Vision -->
  <Section class="bg-surface">
    <div class="grid grid-cols-1 gap-xl md:grid-cols-2 md:gap-lg" data-reveal>
      <QuoteBlock label="Our Mission">
        To cultivate a dynamic learning universe where students ignite their passions,
        strengthen their character, and develop into curious, capable, and self-driven thinkers
        through personalized, whole-child education.
      </QuoteBlock>
      <QuoteBlock label="Our Vision">
        To become a national model of innovative, personalized education where every student is
        known, inspired, and equipped to thrive as a critical thinker, creative contributor, and
        compassionate leader in any field they choose.
      </QuoteBlock>
    </div>
  </Section>

  <!-- Testimonials carousel -->
  <Testimonials items={testimonials} />

  <!-- Pre-footer CTA -->
  <Section class="border-t border-border">
    <div class="mx-auto max-w-[42rem] text-center" data-reveal>
      <Heading level={2} size="display-m">Ready to explore?</Heading>
      <p class="mt-5 text-body-l text-muted">
        Find the world where your child belongs, or reach out and we'll help you find the fit.
      </p>
      <div class="mt-xl flex flex-wrap items-center justify-center gap-5">
        <Button href="/admissions" size="lg">Apply now</Button>
        <Link href="/contact" class="text-body-m">Or get in touch →</Link>
      </div>
    </div>
  </Section>
</Layout>

<script is:inline>
  (function () {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const els = document.querySelectorAll("[data-reveal]");
    if (reduce || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.animate(
              [
                { opacity: 0, transform: "translateY(14px)" },
                { opacity: 1, transform: "translateY(0)" },
              ],
              { duration: 600, easing: "cubic-bezier(0.2,0.8,0.2,1)", fill: "both" },
            );
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.18 },
    );
    els.forEach((el) => io.observe(el));
  })();
</script>

<style>
  .hero__bg {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 175%;
    height: 175%;
    transform: translate(-50%, -50%);
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(32rem 28rem at 50% 22%, color-mix(in srgb, var(--color-earth) 15%, transparent), transparent 62%),
      radial-gradient(32rem 28rem at 78% 50%, color-mix(in srgb, var(--color-fire) 13%, transparent), transparent 62%),
      radial-gradient(32rem 30rem at 50% 78%, color-mix(in srgb, var(--color-water) 15%, transparent), transparent 62%),
      radial-gradient(32rem 28rem at 22% 50%, color-mix(in srgb, var(--color-air) 18%, transparent), transparent 62%);
    animation: hero-drift 150s linear infinite;
  }
  .hero > :not(.hero__bg):not(.constellation) {
    position: relative;
    z-index: 1;
  }
  .hero__logo {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(150px, 24vw, 260px);
    aspect-ratio: 1 / 1;
    opacity: 0;
    animation:
      hero-mark-in 1s var(--ease-refined) both,
      hero-float 7s var(--ease-refined) 1s infinite;
  }
  /* swirling four-element color halo around the mark */
  .hero__logo::before {
    content: "";
    position: absolute;
    inset: -7%;
    border-radius: 9999px;
    background: conic-gradient(
      from 0deg,
      var(--color-earth),
      var(--color-fire),
      var(--color-water),
      var(--color-air),
      var(--color-earth)
    );
    filter: blur(15px);
    opacity: 0.32;
    z-index: 0;
    animation: hero-swirl 9s linear infinite;
  }
  .hero__mark {
    position: relative;
    z-index: 1;
    width: 86%;
    height: auto;
  }
  .hero__intro {
    opacity: 0;
    animation: hero-fade 0.8s var(--ease-refined) 1.1s both;
  }
  .hero__title {
    display: flex;
    flex-direction: column;
    text-wrap: balance;
  }
  .hero__line {
    display: block;
    opacity: 0;
    transform: translateY(0.45em);
    animation: hero-rise 0.85s var(--ease-refined) both;
  }
  .hero__line:nth-child(1) { animation-delay: 0.35s; }
  .hero__line:nth-child(2) { animation-delay: 0.5s; }
  .hero__cue {
    opacity: 0;
    animation: hero-fade 0.8s var(--ease-refined) 1.5s both;
  }
  @keyframes hero-drift {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }
  @keyframes hero-swirl {
    to { transform: rotate(360deg); }
  }
  @keyframes hero-mark-in {
    from { opacity: 0; scale: 0.85; }
    to { opacity: 1; scale: 1; }
  }
  @keyframes hero-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -10px; }
  }
  @keyframes hero-rise {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-fade {
    to { opacity: 1; }
  }
</style>
