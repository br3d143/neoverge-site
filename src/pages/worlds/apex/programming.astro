---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import SplitSection from "../../../components/SplitSection.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Heading from "../../../components/Heading.astro";
import Prose from "../../../components/Prose.astro";
import ApplicationCTA from "../../../components/ApplicationCTA.astro";
import ApexNav from "../../../components/ApexNav.astro";
import Icon from "../../../components/Icon.astro";

const blocks = [
  { t: "Team Practice", icon: "basketball", s: "Led by an expert college-level coach", b: "Each day begins with high-level, structured team practices that develop offensive and defensive systems, game IQ, communication, and execution under pressure, replicating the intensity and pace of college programs." },
  { t: "Strength & Conditioning", icon: "dumbbell", s: "Led by certified performance experts", b: "Athletes move into a strength and performance block built around functional movement, agility, explosive power, and recovery techniques designed specifically for basketball. Conditioning isn't punishment, it's preparation." },
  { t: "Individual Skill Development", icon: "target", s: "Led by an elite pro-level trainer", b: "Afternoons sharpen individual skills, ball handling, shooting mechanics, footwork, and scoring reads, with personalized instruction that pushes each athlete to refine their strengths and close gaps in their game." },
];
const includes = [
  "Elite basketball training tailored to your goals",
  "Competitive games vs. top prep programs",
  "Academic support & NCAA college prep",
  "Mindset & leadership development",
  "Brotherhood, accountability, and purpose",
];
---

<Layout title="Programming, Apex · NeoVerge Dream School" headerTransparent={true}>
  <PageHero
    world="water"
    eyebrow="Apex · Programming"
    title="The Apex Model: Whole-Athlete Development"
    intro="We don't just build players, we shape disciplined, high-performing student-athletes prepared to excel at the next level and beyond. Our program is a complete system that sharpens the body, unlocks the mind, and instills the discipline needed to thrive in sports, school, and life. Every day is designed with purpose. Every session is intentional."
    image="/images/apex-team-court.webp"
    imageAlt="The Apex team and coaches together on the practice court"
  />

  <Section>
    <div data-reveal>
      <Eyebrow tone="water">Three daily training blocks</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3 max-w-[40rem]">Elite coaching. Structured training. Next-level results.</Heading>
    </div>
    <div class="mt-2xl grid grid-cols-1 gap-x-2xl gap-y-xl md:grid-cols-3" data-reveal>
      {blocks.map((bl, i) => (
        <div class="border-t border-border-strong pt-6">
          <span class="flex items-center justify-between gap-3">
            <span class="font-display text-heading-l text-water">{String(i + 1).padStart(2, "0")}</span>
            <Icon name={bl.icon} size={26} class="text-water-accent" />
          </span>
          <Heading level={3} size="heading-m" class="mt-2">{bl.t}</Heading>
          <p class="mt-1 text-body-s text-subtle">{bl.s}</p>
          <p class="mt-3 text-body-m text-muted">{bl.b}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section class="border-t border-border">
    <div data-reveal>
      <Eyebrow tone="water">The Apex Inner System includes</Eyebrow>
    </div>
    <ul class="mt-xl grid gap-x-2xl gap-y-lg sm:grid-cols-2" data-reveal>
      {includes.map((o) => (
        <li class="flex items-start gap-3 border-t border-border-strong pt-4">
          <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-water" aria-hidden="true" />
          <span class="text-body-m text-foreground">{o}</span>
        </li>
      ))}
    </ul>
  </Section>

  <SplitSection world="water" eyebrow="Why Apex" heading="Here, we don't just play. We evolve." class="border-t border-border">
    <Prose centered={false}>
      <p>This is more than training. This is transformation. Whether your goal is a Division 1 scholarship, personal growth, or being ready when your name is called, Apex delivers the structure, mentorship, and intensity to get you there.</p>
    </Prose>
  </SplitSection>

  <ApexNav current="/worlds/apex/programming" />

  <ApplicationCTA world="water" heading="Serious about leveling up?" primaryHref="/admissions/apex" primaryLabel="Apply now" secondaryHref="/contact" secondaryLabel="Contact Coach Quincy" />
</Layout>
