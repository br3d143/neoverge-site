---
/**
 * Apex · Meet the Staff — built from the six AISA staff cards (PDFs in OneDrive).
 * The card band itself lives in components/ApexStaff.astro and is shared with
 * the Apex main page per client request.
 */
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import ApplicationCTA from "../../../components/ApplicationCTA.astro";
import ApexNav from "../../../components/ApexNav.astro";
import ApexStaff from "../../../components/ApexStaff.astro";
---

<Layout title="Meet the Staff, Apex · NeoVerge Dream School" headerTransparent={true}>
  <PageHero
    world="water"
    eyebrow="Apex · Meet the Staff"
    title="Built by people who've been there."
    intro="Every member of the Apex staff has played, coached, or taught at the highest levels: All-American honors, Division 1 careers, pro years overseas, a USC doctorate, and decades of elite player development. Your athlete learns from people who've lived it."
  />

  <ApexStaff />

  <ApexNav current="/worlds/apex/staff" />

  <ApplicationCTA
    world="water"
    heading="Train with a staff that's done it."
    body="From the NBA pipeline to the USC classroom, this staff develops the whole athlete. Come meet them in person."
    primaryHref="/admissions/apex"
    primaryLabel="Apply now"
    secondaryHref="/admissions/apex#schedule"
    secondaryLabel="Schedule a shadow day"
  />
</Layout>
