---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import SplitSection from "../../../components/SplitSection.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Heading from "../../../components/Heading.astro";
import Prose from "../../../components/Prose.astro";
import ApplicationCTA from "../../../components/ApplicationCTA.astro";
import ApexNav from "../../../components/ApexNav.astro";

const deliver = [
  "Position-specific skill development",
  "Strength, conditioning & mobility training",
  "Game film breakdown & IQ sessions",
  "Competition prep for AAU and college recruitment",
];
---

<Layout title="Athletics — Apex · NeoVerge Dream School" headerTransparent={true}>
  <PageHero
    world="water"
    eyebrow="Apex · Athletics"
    title="Where killers are crafted and leaders are born."
    intro="This is more than a hoop dream — it's a blueprint. At Apex, we train with purpose. Every rep, every run, every breakdown session is built to mold championship-level players from the inside out. We don't do cookie-cutter clinics. We develop complete athletes who can dominate the game and lead a team — becoming Apex predators on the court."
  />

  <Section>
    <div data-reveal>
      <Eyebrow tone="water">We deliver</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3 max-w-[40rem]">Complete development, on and off the court.</Heading>
    </div>
    <ul class="mt-2xl grid gap-x-2xl gap-y-lg sm:grid-cols-2" data-reveal>
      {deliver.map((o) => (
        <li class="flex items-start gap-3 border-t border-border-strong pt-4">
          <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-water" aria-hidden="true" />
          <span class="text-body-m text-foreground">{o}</span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Athletics in action -->
  <Section space="compact">
    <figure data-reveal>
      <img
        src="/images/apex-dunk.webp"
        width="2000"
        height="1333"
        alt="An Apex student-athlete finishing a dunk at the rim"
        loading="lazy"
        class="aspect-[3/2] w-full rounded-3xl object-cover"
      />
      <figcaption class="mt-4 text-center">
        <Eyebrow tone="subtle">Every rep, built for the game</Eyebrow>
      </figcaption>
    </figure>
  </Section>

  <SplitSection world="water" eyebrow="Coached by people who've been there" heading="They don't just teach the game — they breathe it." class="border-t border-border">
    <Prose centered={false}>
      <p>Our coaches come from where you're trying to go. If you're built for more, this is where your next level lives — surrounded by people who've already walked the path you're chasing.</p>
    </Prose>
  </SplitSection>

  <ApexNav current="/worlds/apex/athletics" />

  <ApplicationCTA world="water" heading="Ready to put in the work?" primaryHref="/admissions" primaryLabel="Apply now" secondaryHref="/contact" secondaryLabel="Contact Coach Quincy" />
</Layout>
