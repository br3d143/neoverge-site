---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import SplitSection from "../../../components/SplitSection.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Button from "../../../components/Button.astro";
import Link from "../../../components/Link.astro";
import ApexNav from "../../../components/ApexNav.astro";
import { worldInstagram } from "../../../config/site";
---

<Layout title="News & Highlights, Apex · NeoVerge Dream School" headerTransparent={true}>
  <PageHero
    world="water"
    eyebrow="Apex · News & Highlights"
    title="News & Highlights"
    intro="Catch the latest from NeoVerge, from student showcases and athletic achievements to new program launches and educator spotlights. This is where our universe comes to life. See how our students are making waves, taking the stage, and reaching new heights."
    image="/images/apex-game-dunk.webp"
    imageAlt="An Apex athlete rising for a dunk in a live game"
  />

  <SplitSection world="water" eyebrow="Stay in the loop" heading="The latest from our universe.">
    <p class="text-body-l text-muted">Our latest highlights live on Instagram while we build out a curated news feed here. Follow Apex for game recaps, student spotlights, and program updates.</p>
    <div class="mt-8 flex flex-wrap items-center gap-5">
      <Button href={worldInstagram.water} world="water">Follow Apex on Instagram</Button>
      <Link href="/blog" class="text-body-m">Read the blog →</Link>
    </div>
  </SplitSection>

  <ApexNav current="/worlds/apex/news" />
</Layout>
