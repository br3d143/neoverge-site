---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import SplitSection from "../../../components/SplitSection.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Heading from "../../../components/Heading.astro";
import Prose from "../../../components/Prose.astro";
import ApplicationCTA from "../../../components/ApplicationCTA.astro";
import ApexNav from "../../../components/ApexNav.astro";
import Container from "../../../components/Container.astro";
import Link from "../../../components/Link.astro";
import Icon from "../../../components/Icon.astro";
import { forms, youthInstagram } from "../../../config/site";

const seasons = [
  {
    season: "Fall",
    sport: "Football",
    icon: "football",
    body: "Specialized football training built on technique, effort, and the discipline of the game. Athletes learn to read the play, move with purpose, and truly understand football.",
    image: "/images/stock/youth-football.webp",
    imageAlt: "A young ball carrier diving forward with the football during a youth game",
    imagePosition: "60% 40%",
  },
  {
    season: "Winter",
    sport: "Basketball",
    icon: "basketball",
    body: "Competitive basketball training with team strategy at its core. Game IQ, spacing, and execution under pressure, sharpened every single day of the season.",
    image: "/images/stock/youth-basketball.webp",
    imageAlt: "Two kids working on dribbling drills on an outdoor court",
    imagePosition: "center 40%",
  },
  {
    season: "Spring",
    sport: "Baseball & 7v7",
    icon: "baseball",
    body: "Baseball and football 7v7 training. Speed, timing, and live competition close out the year and pull the whole rotation together.",
    image: "/images/stock/youth-spring.webp",
    imageAlt: "A young batter swinging on a grass field beside a flag football ball carrier cutting upfield",
    imagePosition: "center center",
  },
];

const pillars = [
  {
    title: "Basketball Fundamentals",
    coach: "with Donovan Morris",
    coachHref: "/worlds/apex/staff#donovan-morris",
    cred: "Former professional player and AISA Boys Head Coach",
    body: "Daily fundamentals taught by someone who lived the pipeline: prep school, Division 1, and seven pro years overseas. Footwork, handles, and habits that hold up at every level.",
    icon: "basketball",
  },
  {
    title: "Performance Strength & Agility",
    coach: "with Geoff Vaughn",
    coachHref: "/worlds/apex/staff#geoff-vaughn",
    cred: "Master trainer behind USC, UCLA, and NFL-caliber athletes",
    body: "World-class strength and agility work, every day, all year. Functional movement, explosive power, and body control, built for young athletes and scaled to each age.",
    icon: "dumbbell",
  },
];

// Sample daily schedules. Everything after 9:00 AM is shared structure; the first
// block (and Winter's fundamentals label) rotates with the season.
type Row = { time: string; activity: string; detail?: string; break?: boolean };
const schedules: { key: string; label: string; rows: Row[] }[] = [
  {
    key: "fall",
    label: "Fall",
    rows: [
      { time: "8:00–9:00", activity: "Football performance training", detail: "Technique & learning the game" },
      { time: "9:00–9:10", activity: "Water break", break: true },
      { time: "9:10–9:50", activity: "Basketball fundamentals", detail: "With Donovan Morris" },
      { time: "9:50–10:10", activity: "Snack & reading break", break: true },
      { time: "10:10–10:50", activity: "Strength & agility", detail: "With Geoff Vaughn" },
      { time: "10:50–11:30", activity: "Lunch", break: true },
      { time: "11:30–2:00", activity: "Academics", detail: "Live instruction, skill-mastery based" },
    ],
  },
  {
    key: "winter",
    label: "Winter",
    rows: [
      { time: "8:00–9:00", activity: "Intensive basketball training", detail: "Team strategy" },
      { time: "9:00–9:10", activity: "Water break", break: true },
      { time: "9:10–9:50", activity: "Basketball fundamentals & skill refining", detail: "With Donovan Morris" },
      { time: "9:50–10:10", activity: "Snack & reading break", break: true },
      { time: "10:10–10:50", activity: "Strength & agility", detail: "With Geoff Vaughn" },
      { time: "10:50–11:30", activity: "Lunch", break: true },
      { time: "11:30–2:00", activity: "Academics", detail: "Live instruction, skill-mastery based" },
    ],
  },
  {
    key: "spring",
    label: "Spring",
    rows: [
      { time: "8:00–9:00", activity: "Baseball & 7v7 performance training", detail: "Speed, timing & live competition" },
      { time: "9:00–9:10", activity: "Water break", break: true },
      { time: "9:10–9:50", activity: "Basketball fundamentals", detail: "With Donovan Morris" },
      { time: "9:50–10:10", activity: "Snack & reading break", break: true },
      { time: "10:10–10:50", activity: "Strength & agility", detail: "With Geoff Vaughn" },
      { time: "10:50–11:30", activity: "Lunch", break: true },
      { time: "11:30–2:00", activity: "Academics", detail: "Live instruction, skill-mastery based" },
    ],
  },
];
---

<Layout title="AISA Youth, Apex · NeoVerge Dream School" headerTransparent={true}>
  <PageHero
    world="water"
    eyebrow="Apex · AISA Youth · Grades 3–8"
    title="The next generation of elite starts here."
    intro="AISA Youth is an elite sports academy for ambitious boys and girls in grades 3 through 8. This is not an after-school program or a casual league. It's a year-round system where young athletes train with professionals, compete across three sports, and master academics at their own pace."
    image="/images/stock/apex-1.webp"
    imageAlt="A young athlete working on ball-handling drills on an outdoor court"
    imageAspect="aspect-[4/5]"
  />

  <Container class="pt-6">
    <Link href="/worlds/apex" tone="muted" class="text-body-s">← Part of Apex · see the Basketball Academy</Link>
  </Container>

  <!-- Seasonal rotation -->
  <Section>
    <div class="grid gap-lg md:grid-cols-[1.2fr_0.8fr] md:items-end" data-reveal>
      <div>
        <Eyebrow tone="water">A year-round rotation</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3 max-w-[40rem]">
          Three seasons. One complete athlete.
        </Heading>
      </div>
      <p class="text-body-m text-muted">
        The curriculum shifts with the seasons on purpose, building versatile sportsmanship instead
        of one-sport burnout. Training runs year-round out of our home base in the City of Industry,
        and every season gets the same professional intensity.
      </p>
    </div>
    <div class="mt-2xl grid grid-cols-1 gap-x-2xl gap-y-xl md:grid-cols-3" data-reveal>
      {
        seasons.map((s, i) => (
          <div class="border-t border-border-strong pt-6">
            <span class="flex items-center justify-between gap-3">
              <span class="font-display text-heading-l text-water">{String(i + 1).padStart(2, "0")}</span>
              <Icon name={s.icon} size={26} class="text-water-accent" />
            </span>
            <img
              src={s.image}
              alt={s.imageAlt}
              width="1600"
              height="1200"
              loading="lazy"
              class="mt-4 aspect-[4/3] w-full rounded-2xl object-cover"
              style={`object-position: ${s.imagePosition}`}
            />
            <p class="mt-4 font-body text-eyebrow uppercase tracking-[0.14em] text-water-accent">{s.season}</p>
            <Heading level={3} size="heading-m" class="mt-1">{s.sport}</Heading>
            <p class="mt-3 text-body-m text-muted">{s.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Daily pillars -->
  <Section class="bg-water-tint">
    <div data-reveal>
      <Eyebrow tone="water">Every day, all year</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3 max-w-[40rem]">
        Two pillars that never rotate.
      </Heading>
      <p class="mt-5 max-w-[42rem] text-body-l text-muted">
        Whatever the season, every training day includes the same two constants, taught by coaches
        who have done it at the highest level.
      </p>
    </div>
    <div class="mt-2xl grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-[0.55fr_1fr_1fr_0.55fr]" data-reveal>
      <img
        src="/images/stock/youth-hoops-flex.webp"
        alt="A young player flexing with a basketball under his arm at a sunny park court"
        width="1600"
        height="2400"
        loading="lazy"
        class="hidden h-full w-full rounded-3xl object-cover lg:block"
      />
      {
        pillars.map((p) => (
          <div class="flex flex-col gap-4 rounded-3xl border border-border bg-surface p-8">
            <span class="flex items-center justify-between gap-3">
              <Icon name={p.icon} size={28} class="text-water-accent" />
            </span>
            <div>
              <Heading level={3} size="heading-m">{p.title}</Heading>
              <p class="mt-1 text-body-m font-semibold text-water-accent">
                <a href={p.coachHref} class="hover:underline">{p.coach}</a>
              </p>
              <p class="mt-0.5 text-body-s text-subtle">{p.cred}</p>
            </div>
            <p class="text-body-m text-muted">{p.body}</p>
          </div>
        ))
      }
      <img
        src="/images/stock/youth-strength.webp"
        alt="A young athlete focused on a dumbbell curl during strength training"
        width="1600"
        height="2400"
        loading="lazy"
        class="hidden h-full w-full rounded-3xl object-cover lg:block"
      />
    </div>

    <div class="mt-xl rounded-3xl border border-border bg-surface p-8 md:p-10" data-reveal>
      <div class="grid gap-lg md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <p class="font-body text-eyebrow uppercase tracking-[0.14em] text-water-accent">Want extra reps?</p>
          <Heading level={3} size="heading-m" class="mt-2">Private sessions, on request.</Heading>
          <p class="mt-3 max-w-[46rem] text-body-m text-muted">
            Students can request private one-on-one sessions with any member of the staff after
            school hours, whether that's extra skill work, strength training, or academic support.
          </p>
        </div>
        <a href="/worlds/apex/staff" class="font-body text-body-m font-semibold text-water-accent hover:underline">Meet the staff →</a>
      </div>
    </div>
  </Section>

  <!-- Academics -->
  <SplitSection world="water" eyebrow="Academics & mindset" heading="A sharp mind alongside a powerful body." class="border-t border-border">
    <Prose centered={false}>
      <p>A true champion needs both. That's why every day at AISA Youth ends with live academic instruction led by a California credentialed teacher. No packets, no screens-only shortcuts, real teaching, every day.</p>
      <p>We also broke away from rigid, traditional schooling on purpose. Our academic model is strictly skill-mastery based rather than grade-level based, so every child masters critical concepts at their own optimal pace. Students build unshakeable academic confidence without hindering their athletic pursuits.</p>
      <p>And because champions are built between the ears too, students train the mind directly: mental training led by <a href="/worlds/apex/staff#dr-shayna-markwongnark">Dr. Markwongnark</a>, our certified and licensed Director of Education, plus public speaking training that builds the confidence to lead in a huddle, a classroom, or an interview.</p>
    </Prose>
  </SplitSection>

  <!-- Sample day -->
  <Section class="border-t border-border" id="schedule">
    <div class="grid gap-lg md:grid-cols-[1.2fr_0.8fr] md:items-end" data-reveal>
      <div>
        <Eyebrow tone="water">A day at AISA Youth</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3 max-w-[40rem]">
          One structured day. Three seasonal focuses.
        </Heading>
      </div>
      <p class="text-body-m text-muted">
        Monday through Wednesday, the rhythm of the day stays the same all year. Only the morning
        focus block changes with the season, so athletes always know what excellence looks like
        when they walk in.
      </p>
    </div>

    <div class="mt-2xl" data-schedule data-reveal>
      <div role="tablist" aria-label="Sample schedule by season" class="flex flex-wrap gap-2">
        {
          schedules.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`season-tab-${s.key}`}
              aria-controls={`season-panel-${s.key}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="season-tab inline-flex min-h-[44px] items-center rounded-full border border-border-strong px-6 py-2.5 font-body text-body-s font-semibold text-muted transition-all duration-[250ms] [transition-timing-function:var(--ease-refined)] hover:border-water hover:text-water-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground aria-selected:border-transparent aria-selected:bg-water aria-selected:text-foreground"
            >
              {s.label}
            </button>
          ))
        }
      </div>

      {
        schedules.map((s, i) => (
          <div
            role="tabpanel"
            id={`season-panel-${s.key}`}
            aria-labelledby={`season-tab-${s.key}`}
            hidden={i !== 0}
            class="mt-xl"
          >
            <ol class="flex flex-col">
              {s.rows.map((r) => (
                <li
                  class:list={[
                    "grid grid-cols-1 gap-1 border-t border-border-strong py-4 sm:grid-cols-[9.5rem_1fr] sm:gap-6",
                    r.break && "opacity-70",
                  ]}
                >
                  <span class="font-body text-body-s font-semibold uppercase tracking-wider text-water-accent">{r.time}</span>
                  <span>
                    <span class:list={["text-body-m", r.break ? "text-muted" : "font-semibold text-foreground"]}>{r.activity}</span>
                    {r.detail && <span class="block text-body-s text-muted sm:mt-0.5">{r.detail}</span>}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
      <p class="mt-6 text-body-s text-subtle">
        Sample Monday–Wednesday schedule, 8:00 AM to 2:00 PM. Exact blocks flex with facilities and the competition calendar.
      </p>
    </div>

    <div class="mt-xl grid items-center gap-6 rounded-3xl border border-water/40 bg-water-tint p-8 md:grid-cols-[auto_1fr] md:p-10" data-reveal>
      <Icon name="heart" size={40} class="hidden text-water-accent md:block" />
      <div>
        <p class="font-body text-eyebrow uppercase tracking-[0.14em] text-water-accent">Thursdays</p>
        <Heading level={3} size="heading-m" class="mt-2">Recovery day.</Heading>
        <p class="mt-3 max-w-[46rem] text-body-m text-muted">
          Thursdays dial the intensity down on purpose. Athletes recover their bodies with mobility
          and regeneration work, then keep it light with fun games and friendly competitions inside
          the sports. Young athletes should fall in love with the game, not burn out on it.
        </p>
      </div>
    </div>
  </Section>

  <!-- For parents -->
  <SplitSection world="water" eyebrow="For parents with big goals" heading="Turn potential into undeniable excellence." class="border-t border-border">
    <Prose centered={false}>
      <p>If you're dreaming of collegiate scholarships, professional sports careers, and real academic confidence for your child, this is where that journey begins. AISA Youth provides the structure, the elite coaching, and the personalized academic rigor to get there, starting years before everyone else does.</p>
      <p>Follow the journey on Instagram: <a href={youthInstagram} target="_blank" rel="noopener noreferrer">@apexinnersystemathletics_youth</a></p>
    </Prose>
  </SplitSection>

  <ApexNav current="/worlds/apex/youth" />

  <ApplicationCTA
    world="water"
    heading="Give your child the ultimate competitive edge."
    body="AISA Youth is built for ambitious families. Express interest today and we'll walk you through the next steps."
    primaryHref={forms.youthInterest}
    primaryLabel="Express interest"
    secondaryHref="/contact"
    secondaryLabel="Contact Coach Quincy"
  />
</Layout>

<script is:inline>
  (function () {
    document.querySelectorAll("[data-schedule]").forEach((root) => {
      const tabs = Array.from(root.querySelectorAll("[role='tab']"));
      const panels = Array.from(root.querySelectorAll("[role='tabpanel']"));
      if (!tabs.length) return;

      const select = (tab, focus) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute("aria-selected", on ? "true" : "false");
          t.tabIndex = on ? 0 : -1;
        });
        panels.forEach((p) => {
          p.hidden = p.id !== tab.getAttribute("aria-controls");
        });
        if (focus) tab.focus();
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab, false));
        tab.addEventListener("keydown", (e) => {
          if (e.key === "ArrowRight") { e.preventDefault(); select(tabs[(i + 1) % tabs.length], true); }
          if (e.key === "ArrowLeft") { e.preventDefault(); select(tabs[(i - 1 + tabs.length) % tabs.length], true); }
        });
      });
    });
  })();
</script>
