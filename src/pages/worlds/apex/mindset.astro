---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Heading from "../../../components/Heading.astro";
import Prose from "../../../components/Prose.astro";
import Button from "../../../components/Button.astro";
import Link from "../../../components/Link.astro";
import ApplicationCTA from "../../../components/ApplicationCTA.astro";
import ApexNav from "../../../components/ApexNav.astro";
import { forms, partners } from "../../../config/site";

const why = [
  "Confidence fuels performance — deep self-belief built through consistent practice.",
  "Focus keeps athletes locked in under pressure and free of distractions.",
  "Emotional control keeps players steady after a mistake or a bad game.",
  "Visualization and preparation give athletes an edge before they touch the court.",
  "Mental recovery helps players bounce back faster, adapt quicker, and lead stronger.",
];
const includes = [
  "Confidence building and self-talk rewiring",
  "Visualization techniques and performance rituals",
  "Goal-setting strategies that drive action",
  "Bounce-back techniques for failure and frustration",
  "Managing nerves, anxiety, and emotional pressure",
  "Mental health check-ins and ongoing wellness support",
];
---

<Layout title="Mindset Training — Apex · NeoVerge Dream School" headerTransparent={true}>
  <PageHero
    world="water"
    eyebrow="Apex · Mindset Training"
    title="Because the game starts in your head."
    intro="Talent gets you in the gym. Mindset keeps you there. We've partnered with Zenith Mindset — certified coaches who specialize in competitive student-athletes — for whole-group sessions and one-on-one coaching that unlock each athlete's full potential on and off the court."
  />

  <Section>
    <div data-reveal>
      <Eyebrow tone="water">Why mental training matters</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3 max-w-[42rem]">The best athletes don't just train harder — they think sharper.</Heading>
    </div>
    <ul class="mt-2xl grid gap-x-2xl gap-y-lg sm:grid-cols-2" data-reveal>
      {why.map((o) => (
        <li class="flex items-start gap-3 border-t border-border-strong pt-4">
          <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-water" aria-hidden="true" />
          <span class="text-body-m text-foreground">{o}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section width="prose" class="border-t border-border">
    <div data-reveal>
      <Eyebrow tone="water">Why “Apex Inner System”?</Eyebrow>
      <Prose class="mt-6">
        <p>“Apex” represents the highest point — the pursuit of peak performance. But the path to that peak doesn't start with talent. It starts with the inner system that drives everything you do: thought patterns, habits, emotional control, resilience, and belief. We help athletes build those systems deliberately, from the inside out.</p>
        <p>Like water — central to our identity — we teach athletes to move with both force and flexibility. Water adapts to any environment. It nourishes and sustains, but it can also carve through rock. Calm under pressure, relentless in its direction. That's the mindset we train: adaptable, composed, powerful.</p>
      </Prose>
    </div>
  </Section>

  <Section class="border-t border-border">
    <div data-reveal>
      <Eyebrow tone="water">Apex mindset training includes</Eyebrow>
    </div>
    <ul class="mt-xl grid gap-x-2xl gap-y-lg sm:grid-cols-2" data-reveal>
      {includes.map((o) => (
        <li class="flex items-start gap-3 border-t border-border-strong pt-4">
          <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-water" aria-hidden="true" />
          <span class="text-body-m text-foreground">{o}</span>
        </li>
      ))}
    </ul>
    <div class="mt-2xl flex flex-wrap items-center gap-5" data-reveal>
      <Button href={forms.zenithBooking} world="water">Schedule a 1-on-1 session</Button>
      <Link href={partners.zenith} class="text-body-m">Visit Zenith Mindset →</Link>
    </div>
  </Section>

  <ApexNav current="/worlds/apex/mindset" />

  <ApplicationCTA world="water" heading="Train the mental, too." primaryHref="/admissions" primaryLabel="Apply now" secondaryHref="/contact" secondaryLabel="Contact Coach Quincy" />
</Layout>
