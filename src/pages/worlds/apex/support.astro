---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import SplitSection from "../../../components/SplitSection.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Heading from "../../../components/Heading.astro";
import Prose from "../../../components/Prose.astro";
import Button from "../../../components/Button.astro";
import ApplicationCTA from "../../../components/ApplicationCTA.astro";
import ApexNav from "../../../components/ApexNav.astro";
import { partners } from "../../../config/site";
---

<Layout title="Support Us, Apex · NeoVerge Dream School" headerTransparent={true}>
  <PageHero
    world="water"
    eyebrow="Apex · Support Us"
    title="Help us build something bigger than basketball."
    intro="Apex International Sports Academy is a nonprofit fueled by heart, hustle, and community support. Every dollar helps us serve more youth, hire more mentors, and open more doors. When you give to Apex, you're not just donating, you're investing in futures."
    image="/images/apex-team-teal.webp"
    imageAlt="The Apex team, united"
  />

  <SplitSection world="water" eyebrow="Impact Crew" heading="Families don't just support the mission, they build it.">
    <Prose centered={false}>
      <p>Our Impact Crew is a community of visionary parents and guardians who roll up their sleeves and bring big ideas to life: organizing school-wide events, leading enrichment experiences, supporting student wellness, and designing spaces where learning can thrive.</p>
      <p><strong>Join a crew. Lead a project. Be the impact.</strong></p>
    </Prose>
  </SplitSection>

  <SplitSection world="water" eyebrow="Become a funding ally" heading="Because changing lives takes a team." class="border-t border-border">
    <Prose centered={false}>
      <p>Apex International Sports Academy is a 501(c)(3) nonprofit that supports organizations like Apex Inner System Athletics. Your gift directly funds students who want to be part of the program.</p>
    </Prose>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={partners.apexISA} world="water">Donate now</Button>
    </div>
  </SplitSection>

  <ApexNav current="/worlds/apex/support" />

  <ApplicationCTA world="water" heading="We need you on our team." primaryHref="/contact" primaryLabel="Get involved" secondaryHref="/worlds/apex" secondaryLabel="Back to Apex" />
</Layout>
