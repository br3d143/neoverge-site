---
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Section from "../../../components/Section.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Heading from "../../../components/Heading.astro";
import Prose from "../../../components/Prose.astro";
import Button from "../../../components/Button.astro";
import ApplicationCTA from "../../../components/ApplicationCTA.astro";
import { partners } from "../../../config/site";
---

<Layout title="Support Us — Apex · NeoVerge Dream School" headerTransparent={true}>
  <PageHero
    world="water"
    eyebrow="Apex · Support Us"
    title="Help us build something bigger than basketball."
    intro="Apex International Sports Academy is a nonprofit fueled by heart, hustle, and community support. Every dollar helps us serve more youth, hire more mentors, and open more doors. When you give to Apex, you're not just donating — you're investing in futures."
  />

  <Section width="prose">
    <div data-reveal>
      <Eyebrow tone="water">Impact Crew</Eyebrow>
      <Prose class="mt-6">
        <p>At NeoVerge, families don't just support the mission — they help build it. Our Impact Crew is a community of visionary parents and guardians who roll up their sleeves and bring big ideas to life: organizing school-wide events, leading enrichment experiences, supporting student wellness, and designing spaces where learning can thrive.</p>
        <p><strong>Join a crew. Lead a project. Be the impact.</strong></p>
      </Prose>
    </div>
  </Section>

  <Section class="border-t border-border" width="prose">
    <div data-reveal>
      <Eyebrow tone="water">Become a funding ally</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3">Because changing lives takes a team.</Heading>
      <Prose class="mt-6">
        <p>Apex International Sports Academy is a 501(c)(3) nonprofit that supports organizations like Apex Inner System Athletics. Your gift directly funds students who want to be part of the program.</p>
      </Prose>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href={partners.apexISA} world="water">Donate now</Button>
      </div>
    </div>
  </Section>

  <ApplicationCTA world="water" heading="We need you on our team." primaryHref="/contact" primaryLabel="Get involved" secondaryHref="/worlds/apex" secondaryLabel="Back to Apex" />
</Layout>
