---
/**
 * WorldWise — full world page. Program details carried over from Shaun's existing
 * EPIC Academy Rose program (rebranded to WorldWise; facts unchanged: schedule,
 * cohorts, offerings, tuition).
 */
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Heading from "../../components/Heading.astro";
import WorldHero from "../../components/WorldHero.astro";
import QuoteBlock from "../../components/QuoteBlock.astro";
import ApplicationCTA from "../../components/ApplicationCTA.astro";
import Icon from "../../components/Icon.astro";
import StepList from "../../components/StepList.astro";
import { worldsContent, worldInstagram } from "../../config/site";

const w = worldsContent.air;
const waitlist = `mailto:${w.contact}?subject=Waitlist%20${encodeURIComponent(w.name)}`;
const inquire = `mailto:${w.contact}?subject=WorldWise%20Zoom%20Call%20Request`;

const glance = [
  { label: "Days", value: "Tuesdays & Thursdays" },
  { label: "Hours", value: "9:00 AM – 2:00 PM" },
  { label: "Location", value: "311 S. Citrus St., West Covina, CA" },
  { label: "School year", value: "Mid-August – Mid-May" },
  { label: "Cohorts", value: "K & 1st · 2nd & 3rd · 4th & 5th" },
  { label: "Class size", value: "Limited spaces for quality instruction" },
];

// Application process carried over from the program's apply page.
const applySteps = [
  {
    title: "Inquire Now",
    body: "Schedule a Zoom call with us to learn more about our program, curriculum, and enrollment process.",
    href: inquire,
  },
  {
    title: "Complete the Online Application",
    body: "Submit the online application with a non-refundable $100 application fee to secure enrollment.",
  },
  {
    title: "Application Review",
    body: "We review your application and contact you with next steps if space is available. If the program reaches capacity, you'll be added to the waitlist and we'll reach out as soon as a spot opens up.",
  },
];

const fullDay = [
  "Core academics: reading, writing, math, science, and history",
  "Spanish language & culture",
  "Project-based learning",
  "Outdoor recess & lunch",
];

const afterHours = [
  "Musical theatre",
  "Cooking",
  "Sports",
  "Life skills",
  "Financial literacy",
];

const values = [
  { icon: "sparkles", title: "Curiosity", body: "Inspiring lifelong learners through exploration and discovery." },
  { icon: "trophy", title: "Resilience", body: "Building the confidence to take on challenges and grow through them." },
  { icon: "compass", title: "Independence", body: "Encouraging self-led learning, critical thinking, and problem-solving." },
];

const curriculum = [
  { title: "Expert-selected", body: "Master educators carefully curate high-quality, vetted curricula for every cohort." },
  { title: "Evidence-based", body: "Resources backed by research and proven learning strategies." },
  { title: "Tailored learning", body: "Built to meet diverse learning styles and homeschool needs, with GATE depth-and-complexity icons guiding how far each learner goes." },
];

const beyond = [
  "Field trips and real-world learning experiences that connect classroom lessons to authentic, hands-on discovery",
  "Community partnerships linking students with local organizations and businesses",
  "Entrepreneurship education: how to build a business, plus smart money habits from an early age",
];
---

<Layout title="WorldWise Hybrid Academy — NeoVerge Dream School" headerTransparent={true}>
  <WorldHero
    world="air"
    name={w.name}
    meta={w.grades}
    heading={w.heroHeading}
    tagline={w.tagline}
    intro={w.intro}
    status={w.status}
    logo={w.logo}
    primaryHref={waitlist}
    primaryLabel="Join the waitlist"
    secondaryHref={worldInstagram.air}
    secondaryLabel="Follow on Instagram"
  />

  <!-- Mission & Vision -->
  <Section class="bg-air-tint">
    <div class="grid grid-cols-1 gap-xl md:grid-cols-2 md:gap-lg" data-reveal>
      <QuoteBlock label="Our Mission">{w.mission}</QuoteBlock>
      <QuoteBlock label="Our Vision">{w.vision}</QuoteBlock>
    </div>
  </Section>

  <!-- The program -->
  <Section>
    <div class="grid items-center gap-xl md:grid-cols-2 md:gap-2xl">
      <div data-reveal>
        <Eyebrow tone="air">The program</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3">
          A unique learning experience for homeschoolers.
        </Heading>
        <p class="mt-5 text-body-l text-muted">
          Looking for the perfect way to enrich your homeschooling journey? WorldWise is a
          drop-off program for homeschool and independent-study students, offering
          high-quality, hands-on enrichment in a structured and engaging setting, with
          individualized attention and a supportive, loving learning environment.
        </p>
      </div>
      <div data-reveal>
        <img
          src="/images/stock/trail-friends.webp"
          width="1200"
          height="800"
          alt="WorldWise learners exploring together outdoors"
          loading="lazy"
          class="aspect-[4/3] w-full rounded-3xl object-cover"
        />
      </div>
    </div>

    <!-- At a glance -->
    <dl class="mt-2xl grid grid-cols-1 gap-x-lg gap-y-6 sm:grid-cols-2 md:grid-cols-3" data-reveal>
      {glance.map((g) => (
        <div class="border-t border-border-strong pt-4">
          <dt class="font-body text-eyebrow uppercase text-subtle">{g.label}</dt>
          <dd class="mt-1.5 font-display text-heading-s text-foreground">{g.value}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <!-- Blended cohorts -->
  <Section class="border-t border-border">
    <div class="grid grid-cols-1 gap-xl md:grid-cols-2 md:gap-2xl">
      <div data-reveal>
        <Eyebrow tone="air">Blended cohorts</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3">
          Small combo classes, big collaboration.
        </Heading>
      </div>
      <div data-reveal>
        <p class="text-body-l text-muted">
          Classrooms are structured as blended cohorts to provide a dynamic, collaborative
          learning experience while maintaining focus for individualized attention. Students
          are grouped into combo classes, Kindergarten &amp; 1st grade, 2nd &amp; 3rd grade,
          and 4th &amp; 5th grade, allowing for peer-to-peer learning, mentorship
          opportunities, and differentiated instruction that meets each child's unique needs.
        </p>
        <p class="mt-5 text-body-m text-muted">
          If enrollment grows enough at launch, we may offer independent classes for each
          grade level to further tailor the learning experience. Our goal is flexibility
          without ever compromising quality.
        </p>
      </div>
    </div>
  </Section>

  <!-- A full day of engaging learning -->
  <Section class="border-t border-border">
    <div class="grid items-center gap-xl md:grid-cols-2 md:gap-2xl">
      <div class="md:order-2" data-reveal>
        <Eyebrow tone="air">9:00 AM – 2:00 PM</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3">A full day of engaging learning.</Heading>
        <ul class="mt-xl flex flex-col gap-4">
          {fullDay.map((o) => (
            <li class="flex items-start gap-3 border-t border-border-strong pt-4">
              <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-air" aria-hidden="true" />
              <span class="text-body-m text-foreground">{o}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="md:order-1" data-reveal>
        <img
          src="/images/stock/museum-trip.webp"
          width="1200"
          height="1500"
          alt="Students learning on a museum field trip"
          loading="lazy"
          class="mx-auto aspect-[3/4] w-full max-w-[26rem] rounded-3xl object-cover"
        />
      </div>
    </div>
  </Section>

  <!-- After-hours enrichment -->
  <Section class="border-t border-border">
    <div class="grid items-center gap-xl md:grid-cols-2 md:gap-2xl">
      <div data-reveal>
        <Eyebrow tone="air">2:00 PM – 4:30 PM · Additional cost</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3">
          Extend the learning with after-hours enrichment.
        </Heading>
        <ul class="mt-xl flex flex-col gap-4">
          {afterHours.map((o) => (
            <li class="flex items-start gap-3 border-t border-border-strong pt-4">
              <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-air" aria-hidden="true" />
              <span class="text-body-m text-foreground">{o}</span>
            </li>
          ))}
        </ul>
      </div>
      <div data-reveal>
        <img
          src="/images/stock/cooking-class.webp"
          width="1200"
          height="800"
          alt="Children learning to cook in an enrichment class"
          loading="lazy"
          class="aspect-[4/3] w-full rounded-3xl object-cover"
        />
      </div>
    </div>
  </Section>

  <!-- Values -->
  <Section class="border-t border-border bg-surface">
    <div data-reveal>
      <Eyebrow tone="air">Learning with purpose and passion</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3 max-w-[48rem]">
        Cultivating self-led learners with the critical thinking and problem-solving skills
        to shape a better future.
      </Heading>
    </div>
    <div class="mt-2xl grid grid-cols-1 gap-x-lg gap-y-xl md:grid-cols-3" data-reveal>
      {values.map((v) => (
        <div class="border-t border-border-strong pt-6">
          <Icon name={v.icon} size={28} class="text-air-accent" />
          <Heading level={3} size="heading-l" class="mt-4">{v.title}</Heading>
          <p class="mt-3 text-body-m text-muted">{v.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Curriculum approach -->
  <Section class="border-t border-border">
    <div data-reveal>
      <Eyebrow tone="air">The curriculum</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3 max-w-[40rem]">
        Carefully curated, never one-size-fits-all.
      </Heading>
    </div>
    <div class="mt-2xl grid grid-cols-1 gap-x-2xl gap-y-xl md:grid-cols-3" data-reveal>
      {curriculum.map((c, i) => (
        <div class="border-t border-border-strong pt-6">
          <span class="font-display text-heading-l text-air-accent">{String(i + 1).padStart(2, "0")}</span>
          <Heading level={3} size="heading-m" class="mt-2">{c.title}</Heading>
          <p class="mt-3 text-body-m text-muted">{c.body}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Beyond academics -->
  <Section class="border-t border-border">
    <div data-reveal>
      <Eyebrow tone="air">Beyond academics</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3 max-w-[40rem]">
        The world is the classroom.
      </Heading>
    </div>
    <ul class="mt-2xl grid gap-x-2xl gap-y-lg sm:grid-cols-3" data-reveal>
      {beyond.map((o) => (
        <li class="flex items-start gap-3 border-t border-border-strong pt-4">
          <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-air" aria-hidden="true" />
          <span class="text-body-m text-foreground">{o}</span>
        </li>
      ))}
    </ul>

    <!-- iEARN global partnership spotlight -->
    <div class="mt-2xl rounded-3xl bg-air-tint p-8 md:p-12" data-reveal>
      <div class="grid grid-cols-1 items-center gap-xl md:grid-cols-[auto_1fr] md:gap-2xl">
        <Icon name="globe" size={56} class="text-air-accent" />
        <div>
          <Eyebrow tone="air">Global partnership · iEARN</Eyebrow>
          <Heading level={3} size="heading-l" class="mt-3">
            Connected to classrooms around the world.
          </Heading>
          <p class="mt-4 max-w-[52rem] text-body-l text-muted">
            Through our partnership with iEARN, the International Education and Resource
            Network, students take part in interactive, project-based collaborations with
            classrooms around the world. These global projects build cross-cultural
            understanding, global awareness, and collaborative problem-solving, so learning
            never stops at the classroom walls.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- How to apply -->
  <Section class="border-t border-border">
    <div data-reveal>
      <Eyebrow tone="air">Ready to join?</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3">Three simple steps to apply.</Heading>
    </div>
    <div class="mt-2xl">
      <StepList steps={applySteps} />
    </div>
    <p class="mt-xl text-body-s text-subtle" data-reveal>
      If the program reaches capacity, applicants are added to the waitlist and contacted as
      soon as a spot becomes available.
    </p>
  </Section>

  <!-- Tuition -->
  <Section class="border-t border-border">
    <div class="grid grid-cols-1 gap-xl md:grid-cols-2 md:gap-2xl">
      <div data-reveal>
        <Eyebrow tone="muted">Tuition</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3">Simple, all-inclusive pricing.</Heading>
        <dl class="mt-xl flex flex-col gap-4">
          <div class="flex items-baseline justify-between gap-4 border-t border-border-strong pt-4">
            <dt class="text-body-m text-muted">Core program <span class="text-body-s text-subtle">(Tue & Thu, 9:00–2:00)</span></dt>
            <dd class="font-display text-heading-m text-foreground">$4,000<span class="text-body-s text-subtle">/yr</span></dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-t border-border-strong pt-4">
            <dt class="text-body-m text-muted">After-hours enrichment <span class="text-body-s text-subtle">(2:00–4:30)</span></dt>
            <dd class="font-display text-heading-m text-foreground">+$2,000<span class="text-body-s text-subtle">/yr</span></dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-t border-border-strong pt-4">
            <dt class="text-body-m text-muted">Both programs combined</dt>
            <dd class="font-display text-heading-m text-foreground">$6,000<span class="text-body-s text-subtle">/yr</span></dd>
          </div>
        </dl>
        <p class="mt-6 text-body-s text-subtle">All tuition covers materials and instruction.</p>
      </div>
      <div data-reveal>
        <Eyebrow tone="muted">Charter school funding</Eyebrow>
        <p class="mt-xl text-body-l text-foreground">
          We work as vendors with charter schools that offer funding to help offset tuition
          costs. Contact us to confirm whether your charter school participates.
        </p>
        <p class="mt-6 text-body-m text-muted">
          Questions about tuition or payment? Reach us at
          <a href={`mailto:${w.contact}`} class="font-medium text-foreground underline underline-offset-4">{w.contact}</a>
          or <a href="tel:+12136326484" class="font-medium text-foreground underline underline-offset-4">(213) 632-6484</a>.
          Visit us at 311 S. Citrus St., West Covina, CA 91790.
        </p>
      </div>
    </div>
  </Section>

  <!-- Join the team -->
  <Section class="border-t border-border bg-surface">
    <div class="grid grid-cols-1 gap-xl md:grid-cols-2 md:gap-2xl">
      <div data-reveal>
        <Eyebrow tone="air">Careers</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3">Join our team.</Heading>
        <p class="mt-5 text-body-l text-muted">
          We're building a team of loving, empathetic, and deeply dedicated educators who are
          passionate about education, empowerment, and making a meaningful impact, and who
          share our commitment to fostering curiosity, resilience, and independence.
        </p>
        <p class="mt-5 text-body-m text-muted">
          We're hiring core-subject educators along with specialists in musical theatre,
          cooking, sports, life skills, and financial literacy. Send your resume and cover
          letter to
          <a href={`mailto:${w.contact}?subject=WorldWise%20Teaching%20Application`} class="font-medium text-foreground underline underline-offset-4">{w.contact}</a>.
        </p>
      </div>
      <div data-reveal>
        <Eyebrow tone="muted">Specialist openings</Eyebrow>
        <ul class="mt-xl flex flex-col gap-4">
          {[
            { icon: "music", text: "Musical theatre: acting, singing, and stage performance" },
            { icon: "utensils", text: "Cooking: hands-on culinary experiences" },
            { icon: "trophy", text: "Sports: physical activity and teamwork-based games" },
            { icon: "compass", text: "Life skills: responsibility, communication, and leadership" },
            { icon: "dollar", text: "Financial literacy: smart money habits from an early age" },
          ].map((o) => (
            <li class="flex items-start gap-3 border-t border-border-strong pt-4">
              <Icon name={o.icon} size={20} class="mt-0.5 shrink-0 text-air-accent" />
              <span class="text-body-m text-foreground">{o.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <ApplicationCTA
    world="air"
    heading="Ready to enrich your child's education?"
    body={`${w.name} is launching soon. Join the waitlist and we'll reach out with next steps.`}
    primaryHref={waitlist}
    primaryLabel="Join the waitlist"
    secondaryHref="/contact"
    secondaryLabel="Or get in touch"
  />
</Layout>
