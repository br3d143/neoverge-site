---
/**
 * Pulse Collective — custom world page. Extends the generic WorldPage layout with
 * Shaun's class catalog, weekly schedule, and day-in-the-life (June 2026).
 */
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Heading from "../../components/Heading.astro";
import WorldHero from "../../components/WorldHero.astro";
import QuoteBlock from "../../components/QuoteBlock.astro";
import ApplicationCTA from "../../components/ApplicationCTA.astro";
import PhotoBand from "../../components/PhotoBand.astro";
import Icon from "../../components/Icon.astro";
import { worldsContent, worldInstagram, worldFigures, worldPhotos } from "../../config/site";

const w = worldsContent.fire;
const ig = worldInstagram.fire;
const figures = worldFigures.fire;
const photos = worldPhotos.fire!;

// The studios: every class Pulse offers, grouped by discipline.
const studios = [
  {
    icon: "star",
    title: "Performing Arts & Movement",
    classes: [
      { name: "Acro Class", body: "Physical coordination, tumbling, and high-movement arts." },
      { name: "Specialized Flexibility Class", body: "Dedicated extension, mobility, and contortion work to expand each artist's range." },
      {
        name: "Dance Technique & Choreography",
        body: "Dedicated time for mastering foundational dance mechanics and routine structures.",
        genres: ["Latin", "African", "Hip Hop", "Ballet", "Lyrical", "Contemporary", "Tap", "Jazz"],
      },
      { name: "Dance & Performance Practice", body: "Performance execution, stage presence, and creative improvisation." },
    ],
  },
  {
    icon: "megaphone",
    title: "Theater & Drama",
    classes: [
      { name: "Acting & Theater Training", body: "Core stagecraft, character building, and dramatic fundamentals." },
      { name: "Musical Theatre Production", body: "A full musical staged with a professionally licensed script." },
      { name: "Acting & Monologue Work", body: "Individualized performance preparation, script analysis, and spoken-word delivery." },
    ],
  },
  {
    icon: "sparkles",
    title: "Visual Arts",
    classes: [
      { name: "Painting & Drawing", body: "Extended three-hour studio blocks dedicated to fine arts, technique building, and canvas finishing." },
    ],
  },
  {
    icon: "music",
    title: "Music & Theory",
    classes: [
      { name: "Piano Practice", body: "Learn to play piano with practical keyboard instruction." },
      { name: "Singing", body: "Voice lessons and vocal performance practice." },
      { name: "Piano & Music Theory", body: "A deeper dive into reading music, rhythms, and musical structures." },
    ],
  },
  {
    icon: "users",
    title: "Interdisciplinary Studio",
    classes: [
      { name: "Mixed Arts Studio", body: "A collaborative space for creative showcases, improvisation, and display of ongoing visual projects." },
    ],
  },
];

// Weekly schedule. Each day gets its own cell (matching Shaun's source table);
// `all` rows repeat the same block Monday–Thursday. Friday is the field trip.
type ScheduleRow = { time: string; all?: string; days?: [string, string, string, string]; friday?: string };
const schedule: ScheduleRow[] = [
  { time: "8:00 – 9:30 AM", all: "Daily Ballet Studio: Technique & Placement", friday: "Weekly field trip into the community" },
  { time: "9:30 – 11:30 AM", all: "Academic Block: IEW Science Writing, Reading, Beast Academy Math, Cursive & Spanish" },
  { time: "11:30 – 12:00 PM", all: "Lunch & Recharge" },
  { time: "11:30 – 12:20 PM", all: "Flexibility Class: Extension & Contortion" },
  { time: "12:20 – 12:30 PM", all: "Snack Break" },
  {
    time: "12:30 – 2:00 PM",
    days: ["Acro Class", "Piano, Violin & Guitar", "Fine Arts Studio: Painting & Drawing", "Acting & Monologue"],
  },
  {
    time: "2:00 – 2:45 PM",
    days: ["Dance Genre 1", "Musical Theatre Studio", "Fine Arts Studio", "Voice"],
  },
  {
    time: "2:45 – 3:30 PM",
    days: ["Dance Genre 2", "Musical Theatre Studio", "Fine Arts Studio: Production Design", "Hip Hop Crew & Performance"],
  },
  { time: "3:30 – 4:00 PM", all: "Daily Academic Focus: Typing, then Chess, Reading, or Journaling" },
];
const dayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];

// Render helper: "Title: details" cells get a bold title line + muted detail line.
function splitCell(text: string): { title: string; sub?: string } {
  const i = text.indexOf(": ");
  return i === -1 ? { title: text } : { title: text.slice(0, i), sub: text.slice(i + 2) };
}

// A day in the life (peak day, like a Monday or Thursday).
const dayInLife = [
  {
    time: "7:00 – 8:00 AM",
    title: "Rise & Recharge",
    body: "The day starts with a relaxed morning routine: breakfast and a little downtime to wake up and get mentally ready for an active day.",
  },
  {
    time: "8:00 – 9:30 AM",
    title: "The Elite Dance Studio",
    body: "Instead of starting at a desk, the morning kicks off at the barre. This intensive 90-minute ballet block focuses on precision, core strength, alignment, and classical technique while energy is at its highest.",
  },
  {
    time: "9:30 – 11:30 AM",
    title: "Deep-Dive Academics",
    body: "Fresh off physical training, students transition into a focused two-hour academic session covering IEW Science Writing, Reading, Beast Academy Math, Cursive, and Spanish, blending core STEM disciplines with language and expression.",
  },
  {
    time: "11:30 – 12:00 PM",
    title: "The Midday Pivot",
    body: "A fast-paced 30-minute break to refuel, hydrate, and shift mindsets from traditional academics back to physical performance.",
  },
  {
    time: "11:30 – 12:20 PM",
    title: "Extension & Mobility",
    body: "A specialized flexibility block that pushes athletic boundaries with dedicated extension, mobility, and contortion work.",
  },
  {
    time: "12:20 – 12:30 PM",
    title: "Rapid Snack Break",
    body: "A quick breather to grab an energy boost, swap out gear, and prep for the heavy creative afternoon ahead.",
  },
  {
    time: "12:30 – 2:00 PM",
    title: "Master-Level Creative Studio",
    body: "A major 90-minute arts discipline depending on the day: high-intensity acro and tumbling on Mondays, or acting and monologue work with character development and script breakdown on Thursdays.",
  },
  {
    time: "2:00 – 3:30 PM",
    title: "Specialized Performing Arts Tracks",
    body: "Back-to-back performance genres build versatile artists: two dance genres in rapid succession on Mondays, or voice studio followed by the high-energy Hip Hop Crew & Performance block on Thursdays.",
  },
  {
    time: "3:30 – 4:00 PM",
    title: "Independent Mastery",
    body: "The day winds down with self-paced cognitive skills: typing practice to sharpen technical ability, then chess, reading, or journaling to reflect and process the day.",
  },
];
---

<Layout title={`${w.name} — NeoVerge Dream School`} headerTransparent={true}>
  <WorldHero
    world="fire"
    name={w.name}
    meta={w.grades}
    heading={w.heroHeading}
    tagline={w.tagline}
    intro={w.intro}
    status={w.status}
    logo={w.logo}
    primaryHref="/admissions/pulse"
    primaryLabel="Apply now"
    secondaryHref={ig}
    secondaryLabel="Follow on Instagram"
  />

  <div class="relative isolate overflow-hidden">
    {/* Dancer figures as faint page-background decoration */}
    {
      figures && figures.length > 0 && (
        <div class="wp-decor" aria-hidden="true">
          {figures.map((f, i) => (
            <img src={f} alt="" class={`wp-decor__fig wp-decor__fig--${i}`} loading="lazy" />
          ))}
        </div>
      )
    }

    <!-- Mission & Vision -->
    <Section class="bg-fire-tint">
      <div class="grid grid-cols-1 gap-xl md:grid-cols-2 md:gap-lg" data-reveal>
        <QuoteBlock label="Our Mission">{w.mission}</QuoteBlock>
        <QuoteBlock label="Our Vision">{w.vision}</QuoteBlock>
      </div>
    </Section>

    <!-- What Pulse offers -->
    <Section>
      <div data-reveal>
        <Eyebrow tone="fire">What {w.name} offers</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3 max-w-[40rem]">A world built around how your child learns.</Heading>
      </div>
      <div class="mt-2xl grid items-center gap-xl md:grid-cols-2 md:gap-2xl" data-reveal>
        <img
          src={photos[0].src}
          alt={photos[0].alt}
          loading="lazy"
          class="aspect-[3/4] w-full max-w-[26rem] justify-self-center rounded-3xl object-cover"
        />
        <ul class="flex flex-col gap-lg">
          {w.offers.map((o) => (
            <li class="flex items-start gap-3 border-t border-border-strong pt-4">
              <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-fire" aria-hidden="true" />
              <span class="text-body-m text-foreground">{o}</span>
            </li>
          ))}
        </ul>
      </div>
    </Section>

    <!-- The studios: full class catalog -->
    <Section class="border-t border-border">
      <div data-reveal>
        <Eyebrow tone="fire">The studios</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3 max-w-[42rem]">Train across every discipline.</Heading>
        <p class="mt-5 max-w-[42rem] text-body-l text-muted">
          Pulse artists don't pick one lane. From the barre to the easel to the keys, every
          discipline gets dedicated studio time with focused instruction.
        </p>
      </div>
      <div class="mt-2xl grid grid-cols-1 gap-6 md:grid-cols-2" data-reveal>
        {studios.map((s) => (
          <div class="rounded-3xl border border-border bg-surface p-7 md:p-8">
            <div class="flex items-center gap-3">
              <Icon name={s.icon} size={26} class="text-fire-accent" />
              <Heading level={3} size="heading-m">{s.title}</Heading>
            </div>
            <dl class="mt-6 flex flex-col gap-5">
              {s.classes.map((c) => (
                <div class="border-t border-border-strong pt-4">
                  <dt class="font-display text-heading-s text-foreground">{c.name}</dt>
                  <dd class="mt-1.5 text-body-m text-muted">{c.body}</dd>
                  {"genres" in c && c.genres && (
                    <dd class="mt-3 flex flex-wrap gap-2">
                      {c.genres.map((g) => (
                        <span class="rounded-full bg-fire-tint px-3 py-1 text-body-s font-medium text-fire-accent">{g}</span>
                      ))}
                    </dd>
                  )}
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </Section>

    <!-- Weekly schedule -->
    <Section class="border-t border-border">
      <div data-reveal>
        <Eyebrow tone="fire">The weekly rhythm</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3 max-w-[40rem]">A week at Pulse.</Heading>
      </div>
      <div class="mt-2xl overflow-x-auto rounded-3xl border border-border" data-reveal>
        <table class="w-full min-w-[64rem] border-collapse text-left">
          <thead>
            <tr class="bg-fire-tint">
              <th scope="col" class="px-4 py-4 font-body text-eyebrow uppercase text-fire-accent">Time</th>
              {dayNames.map((d) => (
                <th scope="col" class="border-l border-border px-4 py-4 font-body text-eyebrow uppercase text-fire-accent">{d}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {schedule.map((row) => {
              const cells = row.all
                ? [row.all, row.all, row.all, row.all]
                : (row.days! as string[]);
              return (
                <tr class="border-t border-border">
                  <th scope="row" class="whitespace-nowrap px-4 py-4 align-top font-display text-body-s font-medium text-foreground">{row.time}</th>
                  {cells.map((c) => {
                    const cell = splitCell(c);
                    return (
                      <td class="border-l border-border px-4 py-4 align-top">
                        <span class="block text-body-s font-semibold text-foreground">{cell.title}</span>
                        {cell.sub && <span class="mt-1 block text-body-s text-muted">{cell.sub}</span>}
                      </td>
                    );
                  })}
                  <td class="border-l border-border bg-fire-tint/40 px-4 py-4 align-top">
                    {row.friday && (
                      <span class="block text-body-s font-semibold italic text-fire-accent">{row.friday}</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </Section>

    <!-- Day in the life -->
    <Section class="border-t border-border bg-surface">
      <div data-reveal>
        <Eyebrow tone="fire">Day in the life</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3 max-w-[44rem]">From the barre to the stage.</Heading>
        <p class="mt-5 max-w-[44rem] text-body-l text-muted">
          A day at Pulse balances highly structured technical discipline in the morning with
          immersive, creative studio work in the afternoon. Here's what a peak day looks like.
        </p>
      </div>
      <ol class="mt-2xl flex max-w-[52rem] flex-col" data-reveal>
        {dayInLife.map((step, i) => (
          <li class="relative flex gap-6 pb-10 last:pb-0">
            {i < dayInLife.length - 1 && (
              <span class="absolute left-[7px] top-5 h-full w-px bg-border-strong" aria-hidden="true" />
            )}
            <span class="mt-1.5 h-[15px] w-[15px] shrink-0 rounded-full border-2 border-fire bg-background" aria-hidden="true" />
            <div>
              <p class="font-body text-eyebrow uppercase text-fire-accent">{step.time}</p>
              <Heading level={3} size="heading-s" class="mt-1.5">{step.title}</Heading>
              <p class="mt-2 text-body-m text-muted">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </Section>

    <!-- Photography -->
    <Section class="border-t border-border">
      <div class="mx-auto max-w-[42rem] text-center" data-reveal>
        <Eyebrow tone="fire">Inside {w.name}</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3">A glimpse of the everyday.</Heading>
      </div>
      <PhotoBand photos={photos.slice(1)} class="mt-2xl" />
    </Section>

    <ApplicationCTA
      world="fire"
      heading="Be first through the door."
      body={`${w.name} is now accepting early applications. Apply to join the founding cohort.`}
      primaryHref="/admissions/pulse"
      primaryLabel="Apply now"
      secondaryHref="/contact"
      secondaryLabel="Or get in touch"
    />
  </div>
</Layout>

<style>
  /* Faint dancer figures spread across the page (same treatment as WorldPage) */
  .wp-decor {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .wp-decor__fig {
    position: absolute;
    width: auto;
    opacity: 0.12;
    transform-origin: bottom center;
    animation: wp-sway 6s var(--ease-refined, ease-in-out) infinite;
  }
  .wp-decor__fig--0 {
    height: clamp(260px, 30vw, 480px);
    top: 18%;
    left: -5%;
    rotate: -4deg;
  }
  .wp-decor__fig--1 {
    height: clamp(300px, 34vw, 560px);
    top: 46%;
    right: -6%;
    rotate: 5deg;
    animation-delay: 0.9s;
  }
  .wp-decor__fig--2 {
    height: clamp(260px, 30vw, 480px);
    top: 78%;
    left: 4%;
    rotate: -2deg;
    animation-delay: 1.8s;
  }

  @keyframes wp-sway {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-10px) rotate(2.5deg); }
  }

  @media (max-width: 1024px) {
    .wp-decor { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wp-decor__fig { animation: none; }
  }
</style>
