---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import Container from "../../components/Container.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Heading from "../../components/Heading.astro";
import WorldHero from "../../components/WorldHero.astro";
import QuoteBlock from "../../components/QuoteBlock.astro";
import ApplicationCTA from "../../components/ApplicationCTA.astro";
import ApexStaff from "../../components/ApexStaff.astro";
import { worldsContent, apexPages } from "../../config/site";

const w = worldsContent.water;
---

<Layout title="Apex Inner System Athletics, NeoVerge Dream School" headerTransparent={true}>
  <WorldHero
    world="water"
    name={w.name}
    meta={w.grades}
    heading={w.heroHeading}
    tagline={w.tagline}
    intro={w.intro}
    logo={w.logo}
    primaryHref="/admissions/apex"
    primaryLabel="Apply now"
    secondaryHref="/admissions/apex#schedule"
    secondaryLabel="Schedule a tour"
  />

  <!-- Mission & Vision -->
  <Section class="bg-water-tint">
    <div class="grid grid-cols-1 gap-xl md:grid-cols-2 md:gap-lg" data-reveal>
      <QuoteBlock label="Our Mission">{w.mission}</QuoteBlock>
      <QuoteBlock label="Our Vision">{w.vision}</QuoteBlock>
    </div>
  </Section>

  <!-- What Apex offers (with team photo) -->
  <Section>
    <div class="grid items-center gap-xl md:grid-cols-2 md:gap-2xl">
      <div data-reveal>
        <Eyebrow tone="water">What Apex offers</Eyebrow>
        <Heading level={2} size="display-m" class="mt-3">
          A complete system for the whole athlete.
        </Heading>
        <p class="mt-5 text-body-l text-muted">
          Every day is built with purpose, balancing elite training, academic accountability, and
          the inner work that turns talent into leadership.
        </p>
        <ul class="mt-xl flex flex-col gap-4">
          {
            w.offers.map((o) => (
              <li class="flex items-start gap-3 border-t border-border-strong pt-4">
                <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-water" aria-hidden="true" />
                <span class="text-body-m text-foreground">{o}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div data-reveal>
        <img
          src="/images/apex-team-gym.webp"
          width="2000"
          height="1333"
          alt="Apex student-athletes and their coach together in the gym"
          loading="lazy"
          class="aspect-[16/9] w-full rounded-3xl object-cover object-[center_88%]"
        />
      </div>
    </div>
  </Section>

  <!-- Signature image -->
  <Section space="compact">
    <figure data-reveal>
      <img
        src="/images/apex-team-studio.webp"
        width="2000"
        height="1333"
        alt="Coach and the Apex team, together"
        loading="lazy"
        class="aspect-[3/2] w-full rounded-3xl object-cover"
      />
      <figcaption class="mt-4 text-center">
        <Eyebrow tone="subtle">Built from the inside out</Eyebrow>
      </figcaption>
    </figure>
  </Section>

  <!-- Meet the staff (shared card band, also on /worlds/apex/staff) -->
  <ApexStaff heading="Meet the staff behind the system." />

  <!-- Explore the program -->
  <Section class="border-t border-border">
    <div data-reveal>
      <Eyebrow tone="water">Explore the program</Eyebrow>
      <Heading level={2} size="display-m" class="mt-3">Inside the Apex system.</Heading>
    </div>
    <div class="mt-2xl grid grid-cols-1 gap-4 sm:grid-cols-2" data-reveal>
      {
        apexPages.map((p) => (
          <a
            href={p.href}
            class="group flex flex-col gap-2 rounded-2xl border border-border bg-surface p-6 transition-all duration-[250ms] [transition-timing-function:var(--ease-refined)] hover:-translate-y-0.5 hover:border-water/60 hover:shadow-[0_12px_40px_-16px_rgba(26,26,26,0.25)]"
          >
            <span class="flex items-center justify-between gap-3">
              <span class="font-display text-heading-s text-foreground">{p.title}</span>
              <span class="text-water-accent transition-transform duration-[250ms] group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
            <span class="text-body-s text-muted">{p.blurb}</span>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Closing full-width photo band -->
  <section aria-label="Apex team">
    <img
      src="/images/apex-team-bench.webp"
      width="2000"
      height="1333"
      alt="The Apex team seated together in the gym"
      loading="lazy"
      class="h-[44vh] w-full object-cover object-[center_38%] md:h-[56vh]"
    />
  </section>

  <ApplicationCTA
    world="water"
    heading="Ready to put in the work?"
    body="Apex is built for serious student-athletes. If you're committed to the work, we're committed to you."
    primaryHref="/admissions/apex"
    primaryLabel="Apply now"
    secondaryHref="/contact"
    secondaryLabel="Contact Coach Quincy"
  />
</Layout>
